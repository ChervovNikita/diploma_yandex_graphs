    "id": "alg1.l2",
    "ancestors": [
      "alg1.4",
      "alg1",
      "S4.SS1",
      "S4"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "2: Initialize an empty Budget [MATH B] storing nodes for each node type with normalized degree."
