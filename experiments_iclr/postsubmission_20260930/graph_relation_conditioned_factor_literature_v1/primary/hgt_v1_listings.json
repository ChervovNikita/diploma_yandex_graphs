    "id": "alg1.l7",
    "ancestors": [
      "alg1.4",
      "alg1",
      "S4.SS1",
      "S4"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "7: for source node type [MATH \\tau\\in B] do"
