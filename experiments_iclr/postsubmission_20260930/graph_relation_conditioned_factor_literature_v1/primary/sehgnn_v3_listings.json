[
  {
    "tag": "div",
    "id": "alg1.l1",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "1: % Neighbor aggregation"
  },
  {
    "tag": "div",
    "id": "alg1.l2",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "2: Calculate aggregation of raw features for each [MATH \\mathcal{P}\\in\\Phi_{X}] [MATH X^{\\mathcal{P}}{=}\\hat{A}_{c,c_{1}}\\ldots\\hat{A}_{c_{l{-}1}c_{l}}X^{c_{l}},\\,\\,\\,\\,\\mathcal{P}{=}cc_{1}\\ldots c_{l{-}1}c_{l}]"
  },
  {
    "tag": "div",
    "id": "alg1.l3",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "3: Calculate aggregation of labels for each [MATH \\mathcal{P}\\in\\Phi_{Y}] [MATH Y^{\\mathcal{P}}{=}{\\rm rm\\_diag}(\\hat{A}_{c,c_{1}}\\ldots\\hat{A}_{c_{l{-}1}c})Y,\\,\\,\\,\\,\\mathcal{P}{=}cc_{1}\\ldots c_{l{-}1}c]"
  },
  {
    "tag": "div",
    "id": "alg1.l4",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "4: Collect all semantic matrices [MATH M=\\{X^{\\mathcal{P}}:\\mathcal{P}\\in\\Phi_{X}\\}\\bigcup\\{Y^{\\mathcal{P}}:\\mathcal{P}\\in\\Phi_{Y}\\}]"
  },
  {
    "tag": "div",
    "id": "alg1.l5",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "5: for [MATH {\\rm each\\,epoch}] do"
  },
  {
    "tag": "div",
    "id": "alg1.l6",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "6: % Feature projection"
  },
  {
    "tag": "div",
    "id": "alg1.l7",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "7: [MATH {H^{\\prime}}^{\\mathcal{P}_{i}}={\\rm MLP}_{\\mathcal{P}_{i}}(M^{\\mathcal{P}_{i}}),\\,\\,M^{\\mathcal{P}_{i}}\\in M]"
  },
  {
    "tag": "div",
    "id": "alg1.l8",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "8: % Semantic fusion"
  },
  {
    "tag": "div",
    "id": "alg1.l9",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "9: [MATH Q^{\\mathcal{P}_{i}}{=}W_{Q}{H^{\\prime}}^{\\mathcal{P}_{i}},\\,K^{\\mathcal{P}_{i}}{=}W_{K}{H^{\\prime}}^{\\mathcal{P}_{i}},\\,V^{\\mathcal{P}_{i}}{=}W_{V}{H^{\\prime}}^{\\mathcal{P}_{i}}]"
  },
  {
    "tag": "div",
    "id": "alg1.l10",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "10: [MATH \\alpha_{ij}=\\frac{\\exp{(Q^{\\mathcal{P}_{i}}\\cdot{K^{\\mathcal{P}_{j}}}^{T}})}{\\sum_{t}\\exp{(Q^{\\mathcal{P}_{i}}\\cdot{K^{\\mathcal{P}_{t}}}^{T})}}]"
  },
  {
    "tag": "div",
    "id": "alg1.l11",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "11: [MATH H^{\\mathcal{P}_{i}}=\\beta\\sum_{j}\\alpha_{ij}V^{\\mathcal{P}_{i}}+{H^{\\prime}}^{\\mathcal{P}_{i}}]"
  },
  {
    "tag": "div",
    "id": "alg1.l12",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "12: [MATH H^{c}={\\rm concatenate}([H^{\\mathcal{P}_{1}}||H^{\\mathcal{P}_{2}}||\\ldots])]"
  },
  {
    "tag": "div",
    "id": "alg1.l13",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "13: % Downstream tasks"
  },
  {
    "tag": "div",
    "id": "alg1.l14",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "14: [MATH {\\rm Pred}={\\rm MLP}(H^{c})]"
  },
  {
    "tag": "div",
    "id": "alg1.l15",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "15: Calculate loss function [MATH \\mathcal{L}=-\\sum_{i}y_{i}\\ln pred_{i}] , do back-propagation and update network parameters"
  },
  {
    "tag": "div",
    "id": "alg1.l16",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "16: end for"
  },
  {
    "tag": "div",
    "id": "alg1.l17",
    "ancestors": [
      "alg1.4",
      "alg1",
      "Sx5.SSx1",
      "Sx5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "17: return [MATH {\\rm Pred}]"
  }
]
