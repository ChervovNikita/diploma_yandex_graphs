  "bank_RESULT.json": {
    "preserved_keys": [
      "arm",
      "seed",
      "serving",
      "valid",
      "fits",
      "costs"
    ],
    "added_keys": [
      "native_at_corrected_selected",
      "semantics"
    ]
  },
  "selected_VALID.npz": {
    "keys": [
      "ids",
      "y",
      "raw_logits",
      "member_probabilities",
      "probability_mean",
      "member_errors",
      "pooled_errors",
      "native_logits",
      "native_member_probabilities",
      "native_probability_mean",
      "native_member_errors",
      "native_pooled_errors"
    ],
    "authority": "raw_logits is corrected S; native_logits is unchanged native Z at same corrected-selected state; float32 probability means/errors authoritative; stable FP64 raw NLL separate",
    "shapes": "ids/y[N_VALID]; logits/member_probs[M_actual,N_VALID,10]; pooled_probs[N_VALID,10]; member_errors[M_actual,N_VALID]; pooled_errors[N_VALID]"
  },
  "selected.pt": {
    "preserved": "full model/optimizer/streams/step/selection",
    "added_model_state": "dist_U and dist_V or dist_residual.0/2 weights+biases"
  },
  "trace.jsonl": {
    "loss_key": "train_native_corrected_ce",
    "selection_key": "valid",
    "criterion": "strict corrected probability-pool VALID accuracy, earliest ties"
  },
  "SOURCE_HASHES.json": "config_sha256 plus all original/native/extension/helper/semantic-contract file hashes",
  "DESCRIPTOR_SUPPORT.json": "complete nonself record count, buckets/maximum degree/nonempty recipients/tie order, native graph unchanged, one-time preparation and support bytes"
}
