      "complete": true,
      "groups": 15,
      "fit_units": 24,
      "expected_groups": 15,
      "expected_fit_units": 24,
      "native_body_fits": 24,
      "declared_acquisition_arms": [
        "shared4_private_quartile",
        "shared4_private_moments",
        "shared4_common_direction_quartile",
        "factorized_M1_all_signature_quartile",
        "factorized_genuine_I4_all_signature_quartile"
      ],
      "TEST_access": false
    },
    "preserved_keys": [
      "operation_counts",
      "config_sha256",
      "source_sha256",
      "results",
      "comparisons",
      "cost_scope"
    ],
    "added_keys": [
      "distribution_operation_counts",
      "descriptor_support_preparation_once"
    ]
  },
  "fit_RESULT.json": {
    "preserved_keys": [
      "member",
      "native_factor_dropout_seeds",
      "selected_step",
      "completed_updates",
      "selection",
      "restored",
      "selected_state",
      "costs",
      "operation_counts"
    ],
    "added_keys": [
      "native_at_corrected_selected",
      "semantics",
      "native_bodies_fitted",
      "distribution_parameters",
      "distribution_seeds",
      "optimizer_policy",
      "descriptor_support",
      "distribution_operation_counts"
    ],
    "distribution_seeds": {
      "directions": "actual direction draw seeds in source order",
      "joint_residual_head": "actual head seed or null for linear private maps"
    },
    "distribution_operation_counts": [
      "native_route_descriptor_passes",
      "projected_fields",
      "projection_MACs",
      "edge_scalar_gathers",
      "complete_recipient_sort_rows",
      "residual_dense_MACs"
