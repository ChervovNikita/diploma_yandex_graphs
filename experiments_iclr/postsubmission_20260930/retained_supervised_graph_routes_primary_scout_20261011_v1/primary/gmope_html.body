<td id="Sx5.T1.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx5.T1.1.2.3.1" class="ltx_text ltx_underline">87.51</span></td>
<td id="Sx5.T1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx5.T1.1.2.4.1" class="ltx_text ltx_font_bold">87.67</span></td>
<td id="Sx5.T1.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx5.T1.1.2.5.1" class="ltx_text ltx_font_bold">90.87</span></td>
<td id="Sx5.T1.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx5.T1.1.2.6.1" class="ltx_text ltx_font_bold">87.82</span></td>
<td id="Sx5.T1.1.2.7" class="ltx_td ltx_align_center ltx_border_t">86.31</td>
<td id="Sx5.T1.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx5.T1.1.2.8.1" class="ltx_text ltx_underline">88.04</span></td></tr>
