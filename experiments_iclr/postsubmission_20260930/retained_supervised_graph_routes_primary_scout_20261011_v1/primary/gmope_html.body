<td id="A2.T5.1.4.3" class="ltx_td ltx_align_center"><span id="A2.T5.1.4.3.1" class="ltx_text ltx_underline">68.17</span></td></tr>
<tr id="A2.T5.1.5" class="ltx_tr">
<td id="A2.T5.1.5.1" class="ltx_td ltx_align_left">AnyGraph</td>
