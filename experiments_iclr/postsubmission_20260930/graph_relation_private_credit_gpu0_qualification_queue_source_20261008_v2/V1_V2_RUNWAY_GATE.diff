+def lane0_runway(pins, control_pins, helper):
+    """Use the existing controller's current lane budget; never start a new window."""
+    family_live(pins, control_pins, helper)
+    family = read(bound(pins['family_release']))
+    path = inside(family['owner_output_directory']) / 'LANE_0_SCHEDULING.json'
+    require(path.is_file(), 'Existing controller lane0 scheduling receipt required')
+    payload = path.read_bytes()
+    receipt = json.loads(payload, parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
+    receipt_binding = dict(path=str(path.relative_to(PHASE)), sha256=hashlib.sha256(payload).hexdigest(), bytes=len(payload))
+    stamp = datetime.fromisoformat(receipt['UTC'])
+    require(stamp.utcoffset() is not None, 'Controller scheduling receipt needs an aware UTC timestamp')
+    sampled_monotonic = time.monotonic()
+    age = (datetime.now(timezone.utc) - stamp).total_seconds()
+    require(0 <= age <= pins['controller_receipt_max_age_seconds'], 'Controller scheduling receipt stale or future dated')
+    require(receipt['next_cell'] == '6203_alphaF' and receipt['root_lane_admitted'] is False
+            and receipt['scientific_child_started'] is False,
+            'Exact original first unconsumed lane0 cell and prelaunch state required')
+    cumulative = receipt['cumulative_scheduling_seconds']
+    reported = receipt['scheduling_seconds_remaining']
+    allowance = control_pins['scheduling_seconds_per_lane']
+    require(type(cumulative) in (int, float) and type(reported) in (int, float)
+            and math.isfinite(cumulative) and math.isfinite(reported)
+            and 0 <= cumulative < allowance and reported > 0, 'Existing lane scheduling allowance is exhausted/invalid')
+    # Cumulative is sampled at write; reported remaining is sampled before physical/telemetry reads.
+    usable = min(reported, allowance - cumulative) - age - pins['controller_metadata_gap_reserve_seconds']
+    require(usable > 0, 'Existing controller lane0 has no remaining conservative runway')
+    family_live(pins, control_pins, helper)  # Reject terminal receipts appearing during the read.
+    return dict(receipt=receipt_binding, UTC=receipt['UTC'], receipt_age_seconds=age,
+        cumulative_scheduling_seconds=cumulative, reported_remaining_seconds=reported,
+        allowance_remaining_at_write_seconds=allowance - cumulative, usable_remaining_seconds=usable,
+        absolute_queue_monotonic_deadline=sampled_monotonic + usable,
+        metadata_gap_reserve_seconds=pins['controller_metadata_gap_reserve_seconds'])
 
 
