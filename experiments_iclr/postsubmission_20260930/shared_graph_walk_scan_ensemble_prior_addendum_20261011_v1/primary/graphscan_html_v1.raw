<th id="S4.SS1.p3.1.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:-0.75pt 3.0pt;">PlainMamba-L2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">72</a>]</cite></th>
