<tbody class="ltx_tbody">
<tr id="S4.T5.11.2.3" class="ltx_tr">
<th id="S4.T5.11.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.11.2.3.1.1" class="ltx_text" style="font-size:80%;">2</span></th>
<td id="S4.T5.11.2.3.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.11.2.3.2.1" class="ltx_text" style="font-size:80%;">84.1</span></td></tr>
<tr id="S4.T5.11.2.4" class="ltx_tr">
<th id="S4.T5.11.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.11.2.4.1.1" class="ltx_text" style="font-size:80%;">4</span></th>
<td id="S4.T5.11.2.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.11.2.4.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">84.7</span></td></tr>
