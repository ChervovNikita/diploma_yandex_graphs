<th id="S4.T5.11.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.11.2.2.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">1 <math id="S4.T5.m10" class="ltx_Math" alttext="\star" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#F0F0F0;" mathbackground="#F0F0F0">⋆</mo><annotation encoding="application/x-tex">\star</annotation></semantics></math></span></th>
<th id="S4.T5.11.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.11.2.2.2.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">84.4</span></th></tr>
