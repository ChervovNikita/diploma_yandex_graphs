<td id="S3.T1.2.5.3" class="ltx_td ltx_align_center">No</td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center"><math id="S3.T1.m8" class="ltx_Math" alttext="O(|\mathcal{E}|)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(|\mathcal{E}|)</annotation></semantics></math></td></tr>
