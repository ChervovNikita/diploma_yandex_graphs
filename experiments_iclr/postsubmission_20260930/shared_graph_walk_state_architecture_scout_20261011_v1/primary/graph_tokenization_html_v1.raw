<td id="A4.T17.4.2.2" class="ltx_td ltx_align_center ltx_border_t">14,948</td>
<td id="A4.T17.4.2.3" class="ltx_td ltx_align_center ltx_border_t">57</td></tr>
<tr id="A4.T17.4.3" class="ltx_tr">
