<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center">No</td>
<td id="S3.T1.2.3.3" class="ltx_td ltx_align_center">No</td>
<td id="S3.T1.2.3.4" class="ltx_td ltx_align_center"><math id="S3.T1.m6" class="ltx_Math" alttext="O(|\mathcal{V}|+|\mathcal{E}|)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(|\mathcal{V}|+|\mathcal{E}|)</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left">Topological Sort</td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_center">No</td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_center">No</td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_center"><math id="S3.T1.m7" class="ltx_Math" alttext="O(|\mathcal{V}|+|\mathcal{E}|)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(|\mathcal{V}|+|\mathcal{E}|)</annotation></semantics></math></td></tr>
