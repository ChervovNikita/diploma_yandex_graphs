<td id="S3.T1.2.6.3" class="ltx_td ltx_align_center">No</td>
<td id="S3.T1.2.6.4" class="ltx_td ltx_align_center"><math id="S3.T1.m9" class="ltx_Math" alttext="O(|\mathcal{V}|+|\mathcal{E}|)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(|\mathcal{V}|+|\mathcal{E}|)</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.7" class="ltx_tr">
<td id="S3.T1.2.7.1" class="ltx_td ltx_align_left">Canonical SMILES</td>
<td id="S3.T1.2.7.2" class="ltx_td ltx_align_center">Yes</td>
<td id="S3.T1.2.7.3" class="ltx_td ltx_align_center">Yes</td>
<td id="S3.T1.2.7.4" class="ltx_td ltx_align_center"><math id="S3.T1.m10" class="ltx_Math" alttext="O(|\mathcal{V}|+|\mathcal{E}|)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(|\mathcal{V}|+|\mathcal{E}|)</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.8" class="ltx_tr">
<td id="S3.T1.2.8.1" class="ltx_td ltx_align_left">Chinese Postman Problem</td>
