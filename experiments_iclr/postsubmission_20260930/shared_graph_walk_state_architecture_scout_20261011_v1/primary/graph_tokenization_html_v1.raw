<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">No</td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m5" class="ltx_Math" alttext="O(RL)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(RL)</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
