<td id="A2.T7.4.1.8.8" class="ltx_td ltx_align_right ltx_border_r"><math id="A2.T7.m29" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="A2.T7.4.1.8.8.1" class="ltx_text ltx_font_smallcaps"> 0.00031</span></td>
