<td id="A2.T7.4.1.8.10" class="ltx_td ltx_align_right"><math id="A2.T7.m30" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="A2.T7.4.1.8.10.1" class="ltx_text ltx_font_smallcaps"> 0.00361</span></td></tr>
