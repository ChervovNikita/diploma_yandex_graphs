<td id="S3.T2.fig1.2.1.1.5.6" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">–<sup id="S3.T2.fig1.2.1.1.5.6.1" class="ltx_sup">a</sup></td>
<td id="S3.T2.fig1.2.1.1.5.7" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">0.689 (.062)</td></tr>
<tr id="S3.T2.fig1.2.1.1.6" class="ltx_tr">
<td id="S3.T2.fig1.2.1.1.6.1" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">LSTM</td>
<td id="S3.T2.fig1.2.1.1.6.2" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;"><math id="S3.T2.m12" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>-SGD</td>
<td id="S3.T2.fig1.2.1.1.6.3" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;">25</td>
<td id="S3.T2.fig1.2.1.1.6.4" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;">25</td>
<td id="S3.T2.fig1.2.1.1.6.5" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">–<sup id="S3.T2.fig1.2.1.1.6.5.1" class="ltx_sup">a</sup></td>
<td id="S3.T2.fig1.2.1.1.6.6" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">–<sup id="S3.T2.fig1.2.1.1.6.6.1" class="ltx_sup">a</sup></td>
<td id="S3.T2.fig1.2.1.1.6.7" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">0.702 (.044)</td></tr>
<tr id="S3.T2.fig1.2.1.1.7" class="ltx_tr">
<td id="S3.T2.fig1.2.1.1.7.1" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">LSTM</td>
<td id="S3.T2.fig1.2.1.1.7.2" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;"><math id="S3.T2.m13" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>-SGD</td>
<td id="S3.T2.fig1.2.1.1.7.3" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;"><math id="S3.T2.m14" class="ltx_Math" alttext="|{\bm{h}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>𝒉</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\bm{h}}|</annotation></semantics></math></td>
<td id="S3.T2.fig1.2.1.1.7.4" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;"><math id="S3.T2.m15" class="ltx_Math" alttext="|{\bm{h}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>𝒉</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\bm{h}}|</annotation></semantics></math></td>
<td id="S3.T2.fig1.2.1.1.7.5" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">–<sup id="S3.T2.fig1.2.1.1.7.5.1" class="ltx_sup">a</sup></td>
<td id="S3.T2.fig1.2.1.1.7.6" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">–<sup id="S3.T2.fig1.2.1.1.7.6.1" class="ltx_sup">a</sup></td>
<td id="S3.T2.fig1.2.1.1.7.7" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">0.757 (.040) <sup id="S3.T2.fig1.2.1.1.7.7.1" class="ltx_sup">b</sup></td></tr>
<tr id="S3.T2.fig1.2.1.1.8" class="ltx_tr">
<td id="S3.T2.fig1.2.1.1.8.1" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">Identity</td>
<td id="S3.T2.fig1.2.1.1.8.2" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;">exact</td>
<td id="S3.T2.fig1.2.1.1.8.3" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;">1</td>
<td id="S3.T2.fig1.2.1.1.8.4" class="ltx_td ltx_align_right" style="padding-left:3.1pt;padding-right:3.1pt;">1</td>
<td id="S3.T2.fig1.2.1.1.8.5" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">0.860 (.008)</td>
<td id="S3.T2.fig1.2.1.1.8.6" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">0.881 (.011)</td>
<td id="S3.T2.fig1.2.1.1.8.7" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">0.767 (.013)</td></tr>
<tr id="S3.T2.fig1.2.1.1.9" class="ltx_tr">
<td id="S3.T2.fig1.2.1.1.9.1" class="ltx_td ltx_align_left" style="padding-left:3.1pt;padding-right:3.1pt;">(mean-pool)</td>
<td id="S3.T2.fig1.2.1.1.9.2" class="ltx_td" style="padding-left:3.1pt;padding-right:3.1pt;"></td>
<td id="S3.T2.fig1.2.1.1.9.3" class="ltx_td" style="padding-left:3.1pt;padding-right:3.1pt;"></td>
<td id="S3.T2.fig1.2.1.1.9.4" class="ltx_td" style="padding-left:3.1pt;padding-right:3.1pt;"></td>
<td id="S3.T2.fig1.2.1.1.9.5" class="ltx_td" style="padding-left:3.1pt;padding-right:3.1pt;"></td>
