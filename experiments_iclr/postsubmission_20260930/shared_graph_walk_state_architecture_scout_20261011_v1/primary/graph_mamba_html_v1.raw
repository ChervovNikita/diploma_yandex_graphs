<td id="S3.T1.9.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T1.9.1.3.1" class="ltx_text ltx_font_bold">Peptides-Struct</span></td>
<td id="S3.T1.9.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T1.9.1.4.1" class="ltx_text ltx_font_bold">PascalVOC-SP</span></td>
<td id="S3.T1.9.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T1.9.1.5.1" class="ltx_text ltx_font_bold">COCO-SP</span></td>
<td id="S3.T1.9.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T1.9.1.6.1" class="ltx_text ltx_font_bold">MALNET-TINY</span></td></tr>
<tr id="S3.T1.9.2" class="ltx_tr">
<th id="S3.T1.9.2.1" class="ltx_td ltx_th ltx_th_row"></th>
<td id="S3.T1.9.2.2" class="ltx_td ltx_align_center">AP <math id="S3.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
