0 0 -1 48.68 0) translate(24.34,0)"><g style="--ltx-fill-color:#FFCCCC;" fill="#FFCCCC"><path d="M 24.07 -0.26 L -24.07 -0.26 L -24.07 -22.2 L 24.07 -22.2 Z M -24.07 -22.2"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.93 0.0 0.0 0.93 -19.78 -13.34)"><foreignObject style="--ltx-fo-width:3.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.36em;font-size:10pt;" height="14.38" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{(3,4,2)}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{(3,4,2)}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 97.37 0) translate(24.34,0)"><g style="--ltx-fill-color:#FFCCCC;" fill="#FFCCCC"><path d="M 24.07 -0.26 L -24.07 -0.26 L -24.07 -22.2 L 24.07 -22.2 Z M -24.07 -22.2"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.93 0.0 0.0 0.93 -19.78 -13.34)"><foreignObject style="--ltx-fo-width:3.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.36em;font-size:10pt;" height="14.38" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{(3,1,2)}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding=