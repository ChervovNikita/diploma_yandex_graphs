<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">43.3</td>
<td id="S4.T1.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;">53.3</td>
