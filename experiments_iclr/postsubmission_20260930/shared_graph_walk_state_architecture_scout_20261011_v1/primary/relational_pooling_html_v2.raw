ll:none" d="M 16.12 -8.08 C 12.97 -2.62 12.97 2.62 16.12 8.08"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 38.39 29.27)"><foreignObject style="--ltx-fo-width:8.54em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="118.17"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
