+def descriptor(path):
+    path = Path(path)
+    h = sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''): h.update(block)
+    return dict(path=str(path), bytes=path.stat().st_size, sha256=h.hexdigest())
