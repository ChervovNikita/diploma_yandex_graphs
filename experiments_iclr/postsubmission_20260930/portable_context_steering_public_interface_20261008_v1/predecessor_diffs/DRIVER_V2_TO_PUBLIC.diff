+def sha(path):
+    value = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for chunk in iter(lambda: stream.read(1048576), b''):
+            value.update(chunk)
+    return value.hexdigest()
+
+
+def verify_public(root):
+    root = Path(root).resolve()
+    manifest = root / 'MANIFEST.json'
+    if sha(manifest) != PUBLIC_MANIFEST_SHA:
+        raise ValueError('Supply the published portable public v2 code dependency')
+    for row in json.loads(manifest.read_text())['files']:
+        path = root / row['path']
+        if path.stat().st_size != row['bytes'] or sha(path) != row['sha256']:
+            raise ValueError('Public v2 dependency source differs: ' + row['path'])
+    return root
+
+
+def load_public_interface(root):
+    """Load the sealed public dependency from a caller path, for CLI or engineering use."""
+    root = verify_public(root)
+    sys.path.insert(0, str(root))
+    global public, load_train_valid, train_batches, validation_batches, _sha
+    import portable as public
+    import data_interface as data
+    if Path(public.__file__).resolve() != root / 'portable.py' or Path(data.__file__).resolve() != root / 'data_interface.py':
+        raise ValueError('A different public module is cached; run this CLI in a fresh Python process')
+    load_train_valid, train_batches = data.load_train_valid, data.train_batches
+    validation_batches, _sha = data.validation_batches, data._sha
+    return public
+
+
+def initialize_runtime(device):
+    import torch
+    value = torch.device(device)
+    if value.type not in ('cpu', 'cuda'):
+        raise ValueError('Use cpu or cuda[:index]')
+    if value.type == 'cuda':
+        if not torch.cuda.is_available():
+            raise RuntimeError('Requested CUDA is unavailable')
+        value = torch.device('cuda', 0 if value.index is None else value.index)
+        torch.cuda.set_device(value)
+        torch.cuda.reset_peak_memory_stats(value)
+    torch.set_num_threads(2)
+    if torch.get_num_interop_threads() != 1:
+        torch.set_num_interop_threads(1)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    torch.backends.cudnn.benchmark = False
+    return torch, value
+
+
+def usage():
+    if resource is None:
+        return dict(CPU_user_seconds=None, CPU_system_seconds=None, process_cumulative_peak_RSS_bytes=None)
+    value = resource.getrusage(resource.RUSAGE_SELF)
+    return dict(CPU_user_seconds=value.ru_utime, CPU_system_seconds=value.ru_stime,
+                process_cumulative_peak_RSS_bytes=value.ru_maxrss * (1 if sys.platform == 'darwin' else 1024))
+
+
+def install_cost_counters(session):
+    session.public_cost = dict(training_member_calls_attempted=0, training_member_calls_returned=0,
+        development_member_calls_attempted=0, development_member_calls_returned=0,
+        update_calls_attempted=0, update_calls_returned=0, update_wall_seconds=0.)
+    original_member, original_update = session.model.member_forward, session.train_step
+    def member(batch, index):
+        phase = 'training' if session.model.training else 'development'
+        session.public_cost[phase + '_member_calls_attempted'] += 1
+        result = original_member(batch, index)
+        session.public_cost[phase + '_member_calls_returned'] += 1
+        return result
+    def update(batch, labels):
+        began = time.monotonic()
+        session.public_cost['update_calls_attempted'] += 1
+        try:
+            result = original_update(batch, labels)
+            session.public_cost['update_calls_returned'] += 1
+            return result
+        finally:
+            session.public_cost['update_wall_seconds'] += time.monotonic() - began
+    session.model.member_forward, session.train_step = member, update
+
+
