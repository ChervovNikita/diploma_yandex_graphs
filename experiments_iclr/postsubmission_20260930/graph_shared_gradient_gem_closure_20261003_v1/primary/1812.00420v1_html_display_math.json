    "alttext": "\\textsc{LCA}_{\\beta}=\\frac{1}{\\beta+1}\\int_{0}^{\\beta}Z_{b}db=\\frac{1}{\\beta+1}\\sum_{b=0}^{\\beta}Z_{b}"
  },
  {
    "index": 5,
    "id": "S4.Ex1.m1",
    "alttext": "\\textrm{minimize}_{\\theta}\\quad\\ell(f_{\\theta},\\mathcal{D}_{t})\\quad\\textrm{s.t.}\\quad\\ell(f_{\\theta},\\mathcal{M}_{k})\\leq\\ell(f_{\\theta}^{t-1},\\mathcal{M}_{k})\\quad\\quad\\forall k<t\\quad"
  },
  {
