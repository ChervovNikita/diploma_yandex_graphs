    "id": "S4.Ex2.m1",
    "alttext": "\\textrm{minimize}_{\\tilde{g}}\\quad\\frac{1}{2}||g-\\tilde{g}||_{2}^{2}\\quad\\textrm{s.t.}\\quad\\langle\\tilde{g},g_{k}\\rangle\\geq 0\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\forall k<t"
  },
  {
    "index": 7,
    "id": "S4.Ex3.m1",
    "alttext": "\\textrm{minimize}_{v}\\quad\\frac{1}{2}v^{\\top}GG^{\\top}v+g^{\\top}G^{\\top}v\\quad\\textrm{s.t.}\\quad v\\geq 0\\quad\\quad\\quad\\quad\\quad\\quad\\quad\\quad"
  },
  {
