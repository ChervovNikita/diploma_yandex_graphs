  {
    "id": "S4.p1",
    "HTML": "<div id=\"S4.p1\" class=\"ltx_para\">\n<p id=\"S4.p1.2\" class=\"ltx_p\">In this section, we propose Deep Adaptive Graph Neural Network (DAGNN) based on the above insights. Our DAGNN contributes two\nprominent advantages. First, it decouples the representation\ntransformation from propagation so that large receptive fields\ncan be applied without suffering from performance degradation,\nwhich has been verified in Section <a href=\"#S3.SS2\" title=\"3.2. Why Deeper GNNs Fail? ‣ 3. Empirical and Theoretical Analysis of Deep GNNs ‣ Towards Deeper Graph Neural Networks\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_tag\">3.2</span></a>. Second, it\nutilizes an adaptive adjustment mechanism that can adaptively\nbalance the information from local and global neighborhoods for\neach node, thus leading to more discriminative node\nrepresentations. The mathematical expression of DAGNN is defined\nas</p>\n<table id=\"S4.E8\" class=\"ltx_equationgroup ltx_eqn_table\">\n<tbody>\n<tr id=\"S4.E8X\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td rowspan=\"6\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left\"><span class=\"ltx_tag ltx_tag_equationgroup ltx_align_left\">(8)</span></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8X.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{Z}={\\rm MLP}\\left(\\boldsymbol{X}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝒁</mi><mo>=</mo><mrow><mi>MLP</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{Z}={\\rm MLP}\\left(\\boldsymbol{X}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8X.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times c}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xa\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xa.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{H}_{\\ell}=\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z},\\ell=1,2,\\cdots,k\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝑯</mi><msub><mrow></mrow><mi mathvariant=\"normal\">ℓ</mi></msub><mo>=</mo><mover accent=\"true\"><mi>𝑨</mi><mo>^</mo></mover><msup><mrow></mrow><mi mathvariant=\"normal\">ℓ</mi></msup><mi>𝒁</mi><mo>,</mo><mi mathvariant=\"normal\">ℓ</mi><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace=\"0em\" rspace=\"0em\">⋯</mo><mo>,</mo><mi>k</mi></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{H}_{\\ell}=\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z},\\ell=1,2,\\cdots,k</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xa.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times c}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xb\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xb.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{H}={\\rm stack}\\left(\\boldsymbol{Z},\\boldsymbol{H}_{1},\\cdots,\\boldsymbol{H}_{k}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝑯</mi><mo>=</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒁</mi><mo>,</mo><msub><mi>𝑯</mi><mn>1</mn></msub><mo>,</mo><mo lspace=\"0em\" rspace=\"0em\">⋯</mo><mo>,</mo><msub><mi>𝑯</mi><mi>k</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{H}={\\rm stack}\\left(\\boldsymbol{Z},\\boldsymbol{H}_{1},\\cdots,\\boldsymbol{H}_{k}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xb.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo rspace=\"0.055em\" stretchy=\"false\">)</mo></mrow><mo rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times c}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xc\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xc.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{S}=\\sigma\\left(\\boldsymbol{H}\\boldsymbol{s}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝑺</mi><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝑯</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>𝒔</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{S}=\\sigma\\left(\\boldsymbol{H}\\boldsymbol{s}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xc.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times 1}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo rspace=\"0.055em\" stretchy=\"false\">)</mo></mrow><mo rspace=\"0.222em\">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times 1}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xd\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xd.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\widetilde{\\boldsymbol{S}}={\\rm reshape}\\left(\\boldsymbol{S}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mover accent=\"true\"><mi>𝑺</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>reshape</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝑺</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\widetilde{\\boldsymbol{S}}={\\rm reshape}\\left(\\boldsymbol{S}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xd.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times 1\\times(k+1)}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mn>1</mn><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy=\"false\">)</mo></mrow></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times 1\\times(k+1)}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xe\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xe.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{X}_{out}={\\rm softmax}\\left({\\rm squeeze}\\left(\\widetilde{\\boldsymbol{S}}\\boldsymbol{H}\\right)\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi>𝑿</mi><mrow><mi>o</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>u</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>squeeze</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent=\"true\"><mi>𝑺</mi><mo>~</mo></mover><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>𝑯</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{X}_{out}={\\rm softmax}\\left({\\rm squeeze}\\left(\\widetilde{\\boldsymbol{S}}\\boldsymbol{H}\\right)\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xe.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times c},\" display=\"inline\" intent=\":literal\"><semantics><mrow><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times c},</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr></tbody>\n</table>\n<p id=\"S4.p1.3\" class=\"ltx_p\">where <math id=\"S4.p1.m1\" class=\"ltx_Math\" alttext=\"c\" display=\"inline\" intent=\":literal\"><semantics><mi>c</mi><annotation encoding=\"application/x-tex\">c</annotation></semantics></math> is the number of node classes. <math id=\"S4.p1.m2\" class=\"ltx_Math\" alttext=\"\\boldsymbol{Z}\\in\\mathbb{R}^{n\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝒁</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\boldsymbol{Z}\\in\\mathbb{R}^{n\\times c}</annotation></semantics></math> is the feature matrix derived by\napplying an MLP network to the original feature matrix. We utilize\nthe symmetrical normalization propagation mechanism\n<math id=\"S4.p1.m3\" class=\"ltx_Math\" alttext=\"\\widehat{\\boldsymbol{A}}=\\widetilde{\\boldsymbol{D}}^{-\\frac{1}{2}}\\widetilde{\\boldsymbol{A}}\\widetilde{\\boldsymbol{D}}^{-\\frac{1}{2}}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mover accent=\"true\"><mi>𝑨</mi><mo>^</mo></mover><mo>=</mo><mrow><msup><mover accent=\"true\"><mi>𝑫</mi><mo>~</mo></mover><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace=\"0em\" rspace=\"0em\">​</mo><mover accent=\"true\"><mi>𝑨</mi><mo>~</mo></mover><mo lspace=\"0em\" rspace=\"0em\">​</mo><msup><mover accent=\"true\"><mi>𝑫</mi><mo>~</mo></mover><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow></mrow><annotation encoding=\"application/x-tex\">\\widehat{\\boldsymbol{A}}=\\widetilde{\\boldsymbol{D}}^{-\\frac{1}{2}}\\widetilde{\\boldsymbol{A}}\\widetilde{\\boldsymbol{D}}^{-\\frac{1}{2}}</annotation></semantics></math>,\nwhere <math id=\"S4.p1.m4\" class=\"ltx_Math\" alttext=\"\\widetilde{\\boldsymbol{A}}=\\boldsymbol{A}+\\boldsymbol{I}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mover accent=\"true\"><mi>𝑨</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>𝑨</mi><mo>+</mo><mi>𝑰</mi></mrow></mrow><annotation encoding=\"application/x-tex\">\\widetilde{\\boldsymbol{A}}=\\boldsymbol{A}+\\boldsymbol{I}</annotation></semantics></math>.\n<math id=\"S4.p1.m5\" class=\"ltx_Math\" alttext=\"k\" display=\"inline\" intent=\":literal\"><semantics><mi>k</mi><annotation encoding=\"application/x-tex\">k</annotation></semantics></math> is a hyperparameter that indicates the depth of the model.\n<math id=\"S4.p1.m6\" class=\"ltx_Math\" alttext=\"\\boldsymbol{s}\\in\\mathbb{R}^{c\\times 1}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝒔</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>c</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\boldsymbol{s}\\in\\mathbb{R}^{c\\times 1}</annotation></semantics></math> is a trainable\nprojection vector. <math id=\"S4.p1.m7\" class=\"ltx_Math\" alttext=\"\\sigma(\\cdot)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy=\"false\">(</mo><mo lspace=\"0em\" rspace=\"0em\">⋅</mo><mo stretchy=\"false\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">\\sigma(\\cdot)</annotation></semantics></math> is an activation function and\nwe apply <span id=\"S4.p1.3.1\" class=\"ltx_text ltx_font_italic\">sigmoid</span>. <span id=\"S4.p1.3.2\" class=\"ltx_text ltx_font_italic\">stack</span>, <span id=\"S4.p1.3.3\" class=\"ltx_text ltx_font_italic\">reshape</span> and\n<span id=\"S4.p1.3.4\" class=\"ltx_text ltx_font_italic\">squeeze</span> are utilized to rearrange the data dimension so\nthat dimension can be matched during computation.</p>\n</div>\n",
    "math_latex": [
      "\\displaystyle\\boldsymbol{Z}={\\rm MLP}\\left(\\boldsymbol{X}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times c}",
      "\\displaystyle\\boldsymbol{H}_{\\ell}=\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z},\\ell=1,2,\\cdots,k",
      "\\displaystyle\\in\\mathbb{R}^{n\\times c}",
      "\\displaystyle\\boldsymbol{H}={\\rm stack}\\left(\\boldsymbol{Z},\\boldsymbol{H}_{1},\\cdots,\\boldsymbol{H}_{k}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times c}",
      "\\displaystyle\\boldsymbol{S}=\\sigma\\left(\\boldsymbol{H}\\boldsymbol{s}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times 1}",
      "\\displaystyle\\widetilde{\\boldsymbol{S}}={\\rm reshape}\\left(\\boldsymbol{S}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times 1\\times(k+1)}",
      "\\displaystyle\\boldsymbol{X}_{out}={\\rm softmax}\\left({\\rm squeeze}\\left(\\widetilde{\\boldsymbol{S}}\\boldsymbol{H}\\right)\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times c},",
      "c",
      "\\boldsymbol{Z}\\in\\mathbb{R}^{n\\times c}",
      "\\widehat{\\boldsymbol{A}}=\\widetilde{\\boldsymbol{D}}^{-\\frac{1}{2}}\\widetilde{\\boldsymbol{A}}\\widetilde{\\boldsymbol{D}}^{-\\frac{1}{2}}",
      "\\widetilde{\\boldsymbol{A}}=\\boldsymbol{A}+\\boldsymbol{I}",
      "k",
      "\\boldsymbol{s}\\in\\mathbb{R}^{c\\times 1}",
      "\\sigma(\\cdot)"
    ]
  },
  {
    "id": "S4.p2",
    "HTML": "<div id=\"S4.p2\" class=\"ltx_para\">\n<p id=\"S4.p2.1\" class=\"ltx_p\">An illustration of our proposed DAGNN is provided in\nFigure <a href=\"#S3.F5\" title=\"Figure 5 ‣ 3.3. Theoretical Analysis of Very Deep Models ‣ 3. Empirical and Theoretical Analysis of Deep GNNs ‣ Towards Deeper Graph Neural Networks\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_tag\">5</span></a>. There are three main steps in DAGNN:\ntransformation, propagation and adaptive adjustment. We first\nutilize a shared MLP network for feature transformation.\nTheoretically, MLP can approximate any measurable\nfunction <cite class=\"ltx_cite ltx_citemacro_citep\">(<a href=\"#bib.bib11\" title=\"\" class=\"ltx_ref\">Hornik et al., 1989</a>)</cite>. Obviously, <math id=\"S4.p2.m1\" class=\"ltx_Math\" alttext=\"\\boldsymbol{Z}\" display=\"inline\" intent=\":literal\"><semantics><mi>𝒁</mi><annotation encoding=\"application/x-tex\">\\boldsymbol{Z}</annotation></semantics></math>\nonly contains the information of individual nodes themselves with\nno structure information included. After transformation, a\npropagation mechanism <math id=\"S4.p2.m2\" class=\"ltx_Math\" alttext=\"\\widehat{\\boldsymbol{A}}\" display=\"inline\" intent=\":literal\"><semantics><mover accent=\"true\"><mi>𝑨</mi><mo>^</mo></mover><annotation encoding=\"application/x-tex\">\\widehat{\\boldsymbol{A}}</annotation></semantics></math> is applied to\ngather neighborhood information. <math id=\"S4.p2.m3\" class=\"ltx_Math\" alttext=\"\\boldsymbol{H}_{\\ell}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi>𝑯</mi><mi mathvariant=\"normal\">ℓ</mi></msub><annotation encoding=\"application/x-tex\">\\boldsymbol{H}_{\\ell}</annotation></semantics></math> denotes the\nrepresentations obtained by propagating information from nodes\nthat are <math id=\"S4.p2.m4\" class=\"ltx_Math\" alttext=\"\\ell\" display=\"inline\" intent=\":literal\"><semantics><mi mathvariant=\"normal\">ℓ</mi><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math>-hop away, hence <math id=\"S4.p2.m5\" class=\"ltx_Math\" alttext=\"\\boldsymbol{H}_{\\ell}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi>𝑯</mi><mi mathvariant=\"normal\">ℓ</mi></msub><annotation encoding=\"application/x-tex\">\\boldsymbol{H}_{\\ell}</annotation></semantics></math> captures the\ninformation from the subtree of height <math id=\"S4.p2.m6\" class=\"ltx_Math\" alttext=\"\\ell\" display=\"inline\" intent=\":literal\"><semantics><mi mathvariant=\"normal\">ℓ</mi><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math> rooted at individual\nnodes. As the depth <math id=\"S4.p2.m7\" class=\"ltx_Math\" alttext=\"\\ell\" display=\"inline\" intent=\":literal\"><semantics><mi mathvariant=\"normal\">ℓ</mi><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math> increase, more global information is\nincluded in <math id=\"S4.p2.m8\" class=\"ltx_Math\" alttext=\"\\boldsymbol{H}_{\\ell}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi>𝑯</mi><mi mathvariant=\"normal\">ℓ</mi></msub><annotation encoding=\"application/x-tex\">\\boldsymbol{H}_{\\ell}</annotation></semantics></math> because the corresponding subtree\nis deeper. However, it is difficult to determine a suitable <math id=\"S4.p2.m9\" class=\"ltx_Math\" alttext=\"\\ell\" display=\"inline\" intent=\":literal\"><semantics><mi mathvariant=\"normal\">ℓ</mi><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math>.\nSmall <math id=\"S4.p2.m10\" class=\"ltx_Math\" alttext=\"\\ell\" display=\"inline\" intent=\":literal\"><semantics><mi mathvariant=\"normal\">ℓ</mi><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math> may fail to capture sufficient and essential\nneighborhood information, while large <math id=\"S4.p2.m11\" class=\"ltx_Math\" alttext=\"\\ell\" display=\"inline\" intent=\":literal\"><semantics><mi mathvariant=\"normal\">ℓ</mi><annotation encoding=\"application/x-tex\">\\ell</annotation></semantics></math> may bring too much\nglobal information and dilute the special local information.\nFurthermore, each node has a different subtree structure rooted\nat this node and the most suitable receptive field for each node\nshould be different. To this end, we include an adaptive\nadjustment mechanism after the propagation. We utilize a\ntrainable projection vector <math id=\"S4.p2.m12\" class=\"ltx_Math\" alttext=\"\\boldsymbol{s}\" display=\"inline\" intent=\":literal\"><semantics><mi>𝒔</mi><annotation encoding=\"application/x-tex\">\\boldsymbol{s}</annotation></semantics></math> that is shared by\nall nodes to generate retainment scores. These scores are used\nfor representations that carry information from various range of\nneighborhood. These retainment scores measure how much\ninformation of the corresponding representations derived by\ndifferent propagation layers should be retained to generate the\nfinal representation for each node. Utilizing this adaptive adjustment mechanism, DAGNN can adaptively balance the information from local and global neighborhoods for each node. Obviously, the transformation\nprocess and the adaptive adjustment process have trainable\nparameters and there is no trainable parameter in the propagation\nprocess, leading to a parameter-efficient model. Note that DAGNN\nis trained end-to-end, which means that these three steps are\nconsidered together when optimizing the network.</p>\n</div>\n",
    "math_latex": [
      "\\boldsymbol{Z}",
      "\\widehat{\\boldsymbol{A}}",
      "\\boldsymbol{H}_{\\ell}",
      "\\ell",
      "\\boldsymbol{H}_{\\ell}",
      "\\ell",
      "\\ell",
      "\\boldsymbol{H}_{\\ell}",
      "\\ell",
      "\\ell",
      "\\ell",
      "\\boldsymbol{s}"
    ]
  },
  {
    "id": "S4.p3",
    "HTML": "<div id=\"S4.p3\" class=\"ltx_para\">\n<p id=\"S4.p3.1\" class=\"ltx_p\">Decoupling representation transformation from propagation and utilizing\nthe learnable retainment score to adaptively adjust the information from local and\nglobal neighborhoods make DAGNN have the ability to generate\nsuitable representations for specific nodes from large and\nadaptive receptive fields. Besides, removing the entanglement of\nrepresentation transformation and propagation, we can derive a large\nneighborhood without introducing more trainable parameters. Also,\ntransforming representations to a low dimensional space at an early stage\nmakes DAGNN computationally efficient and memory-saving. In order\nto compute <math id=\"S4.p3.m1\" class=\"ltx_Math\" alttext=\"\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z}\" display=\"inline\" intent=\":literal\"><semantics><mrow><msup><mover accent=\"true\"><mi>𝑨</mi><mo>^</mo></mover><mi mathvariant=\"normal\">ℓ</mi></msup><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>𝒁</mi></mrow><annotation encoding=\"application/x-tex\">\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z}</annotation></semantics></math>\nefficiently, we choose to compute it sequentially from right to\nleft with time complexity <math id=\"S4.p3.m2\" class=\"ltx_Math\" alttext=\"\\mathcal{O}(n^{2}c)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi class=\"ltx_font_mathcaligraphic\">𝒪</mi><mo>⁡</mo><mrow><mo stretchy=\"false\">(</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>c</mi></mrow><mo stretchy=\"false\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">\\mathcal{O}(n^{2}c)</annotation></semantics></math>, which saves the\ncomputational cost compared to <math id=\"S4.p3.m3\" class=\"ltx_Math\" alttext=\"\\mathcal{O}(n^{3})\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi class=\"ltx_font_mathcaligraphic\">𝒪</mi><mo>⁡</mo><mrow><mo stretchy=\"false\">(</mo><msup><mi>n</mi><mn>3</mn></msup><mo stretchy=\"false\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">\\mathcal{O}(n^{3})</annotation></semantics></math> of calculating\n<math id=\"S4.p3.m4\" class=\"ltx_Math\" alttext=\"\\widehat{\\boldsymbol{A}}^{\\ell}\" display=\"inline\" intent=\":literal\"><semantics><msup><mover accent=\"true\"><mi>𝑨</mi><mo>^</mo></mover><mi mathvariant=\"normal\">ℓ</mi></msup><annotation encoding=\"application/x-tex\">\\widehat{\\boldsymbol{A}}^{\\ell}</annotation></semantics></math> first.</p>\n</div>\n",
    "math_latex": [
      "\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z}",
      "\\mathcal{O}(n^{2}c)",
      "\\mathcal{O}(n^{3})",
      "\\widehat{\\boldsymbol{A}}^{\\ell}"
    ]
  },
  {
    "id": "S4.p4",
    "HTML": "<div id=\"S4.p4\" class=\"ltx_para\">\n<p id=\"S4.p4.1\" class=\"ltx_p\">Notably, there are no fully-connected layers utilized as a\nclassifier at the end of this model. In our DAGNN, the final\nrepresentations <math id=\"S4.p4.m1\" class=\"ltx_Math\" alttext=\"\\boldsymbol{X}_{out}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi>𝑿</mi><mrow><mi>o</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>u</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>t</mi></mrow></msub><annotation encoding=\"application/x-tex\">\\boldsymbol{X}_{out}</annotation></semantics></math> are used as the final\nprediction. Thus, the cross-entropy loss for all labeled examples\ncan be calculated as</p>\n<table id=\"S4.E9\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left\"><span class=\"ltx_tag ltx_tag_equation ltx_align_left\">(9)</span></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S4.E9.m1\" class=\"ltx_math_unparsed\" alttext=\"\\mathcal{L}=-\\sum_{i\\in V_{L}}\\sum_{p=1}^{c}\\boldsymbol{Y}_{[i,p]}\\ln{\\boldsymbol{X}_{out}}_{[i,p]},\" display=\"block\" intent=\":literal\"><semantics><mrow><mi class=\"ltx_font_mathcaligraphic\">ℒ</mi><mo rspace=\"0em\">=</mo><mo lspace=\"0em\" rspace=\"0.055em\">−</mo><mo movablelimits=\"false\" rspace=\"0em\">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>V</mi><mi>L</mi></msub></mrow></msub><mo movablelimits=\"false\">∑</mo><msub><mrow></mrow><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>c</mi></msup><mi>𝒀</mi><msub><mrow></mrow><mrow><mo stretchy=\"false\">[</mo><mi>i</mi><mo>,</mo><mi>p</mi><mo stretchy=\"false\">]</mo></mrow></msub><mi>ln</mi><mi>𝑿</mi><msub><mrow></mrow><mrow><mi>o</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>u</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>t</mi></mrow></msub><msub><mrow></mrow><mrow><mo stretchy=\"false\">[</mo><mi>i</mi><mo>,</mo><mi>p</mi><mo stretchy=\"false\">]</mo></mrow></msub><mo>,</mo></mrow><annotation encoding=\"application/x-tex\">\\mathcal{L}=-\\sum_{i\\in V_{L}}\\sum_{p=1}^{c}\\boldsymbol{Y}_{[i,p]}\\ln{\\boldsymbol{X}_{out}}_{[i,p]},</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr></tbody>\n</table>\n<p id=\"S4.p4.2\" class=\"ltx_p\">where <math id=\"S4.p4.m2\" class=\"ltx_Math\" alttext=\"V_{L}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi>V</mi><mi>L</mi></msub><annotation encoding=\"application/x-tex\">V_{L}</annotation></semantics></math> is the set of labeled nodes and <math id=\"S4.p4.m3\" class=\"ltx_Math\" alttext=\"\\boldsymbol{Y}\\in\\mathbb{R}^{n\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\boldsymbol{Y}\\in\\mathbb{R}^{n\\times c}</annotation></semantics></math> is the label indicator matrix. <math id=\"S4.p4.m4\" class=\"ltx_Math\" alttext=\"c\" display=\"inline\" intent=\":literal\"><semantics><mi>c</mi><annotation encoding=\"application/x-tex\">c</annotation></semantics></math> is\nthe number of classes.</p>\n</div>\n",
    "math_latex": [
      "\\boldsymbol{X}_{out}",
      "\\mathcal{L}=-\\sum_{i\\in V_{L}}\\sum_{p=1}^{c}\\boldsymbol{Y}_{[i,p]}\\ln{\\boldsymbol{X}_{out}}_{[i,p]},",
      "V_{L}",
      "\\boldsymbol{Y}\\in\\mathbb{R}^{n\\times c}",
      "c"
    ]
  },
  {
    "id": "S4.E8",
    "HTML": "<table id=\"S4.E8\" class=\"ltx_equationgroup ltx_eqn_table\">\n<tbody>\n<tr id=\"S4.E8X\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td rowspan=\"6\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left\"><span class=\"ltx_tag ltx_tag_equationgroup ltx_align_left\">(8)</span></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8X.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{Z}={\\rm MLP}\\left(\\boldsymbol{X}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝒁</mi><mo>=</mo><mrow><mi>MLP</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{Z}={\\rm MLP}\\left(\\boldsymbol{X}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8X.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times c}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xa\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xa.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{H}_{\\ell}=\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z},\\ell=1,2,\\cdots,k\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝑯</mi><msub><mrow></mrow><mi mathvariant=\"normal\">ℓ</mi></msub><mo>=</mo><mover accent=\"true\"><mi>𝑨</mi><mo>^</mo></mover><msup><mrow></mrow><mi mathvariant=\"normal\">ℓ</mi></msup><mi>𝒁</mi><mo>,</mo><mi mathvariant=\"normal\">ℓ</mi><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace=\"0em\" rspace=\"0em\">⋯</mo><mo>,</mo><mi>k</mi></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{H}_{\\ell}=\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z},\\ell=1,2,\\cdots,k</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xa.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times c}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xb\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xb.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{H}={\\rm stack}\\left(\\boldsymbol{Z},\\boldsymbol{H}_{1},\\cdots,\\boldsymbol{H}_{k}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝑯</mi><mo>=</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒁</mi><mo>,</mo><msub><mi>𝑯</mi><mn>1</mn></msub><mo>,</mo><mo lspace=\"0em\" rspace=\"0em\">⋯</mo><mo>,</mo><msub><mi>𝑯</mi><mi>k</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{H}={\\rm stack}\\left(\\boldsymbol{Z},\\boldsymbol{H}_{1},\\cdots,\\boldsymbol{H}_{k}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xb.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times c}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo rspace=\"0.055em\" stretchy=\"false\">)</mo></mrow><mo rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times c}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xc\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xc.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{S}=\\sigma\\left(\\boldsymbol{H}\\boldsymbol{s}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>𝑺</mi><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝑯</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>𝒔</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{S}=\\sigma\\left(\\boldsymbol{H}\\boldsymbol{s}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xc.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times 1}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo rspace=\"0.055em\" stretchy=\"false\">)</mo></mrow><mo rspace=\"0.222em\">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times 1}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xd\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xd.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\widetilde{\\boldsymbol{S}}={\\rm reshape}\\left(\\boldsymbol{S}\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><mover accent=\"true\"><mi>𝑺</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>reshape</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝑺</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\widetilde{\\boldsymbol{S}}={\\rm reshape}\\left(\\boldsymbol{S}\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xd.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times 1\\times(k+1)}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mn>1</mn><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy=\"false\">)</mo></mrow></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times 1\\times(k+1)}</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr>\n<tr id=\"S4.E8Xe\" class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xe.m2\" class=\"ltx_Math\" alttext=\"\\displaystyle\\boldsymbol{X}_{out}={\\rm softmax}\\left({\\rm squeeze}\\left(\\widetilde{\\boldsymbol{S}}\\boldsymbol{H}\\right)\\right)\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi>𝑿</mi><mrow><mi>o</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>u</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>squeeze</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent=\"true\"><mi>𝑺</mi><mo>~</mo></mover><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>𝑯</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\boldsymbol{X}_{out}={\\rm softmax}\\left({\\rm squeeze}\\left(\\widetilde{\\boldsymbol{S}}\\boldsymbol{H}\\right)\\right)</annotation></semantics></math></td>\n<td class=\"ltx_td ltx_eqn_cell\"></td>\n<td class=\"ltx_td ltx_align_left ltx_eqn_cell\"><math id=\"S4.E8Xe.m4\" class=\"ltx_Math\" alttext=\"\\displaystyle\\in\\mathbb{R}^{n\\times c},\" display=\"inline\" intent=\":literal\"><semantics><mrow><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mi>c</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding=\"application/x-tex\">\\displaystyle\\in\\mathbb{R}^{n\\times c},</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr></tbody>\n</table>\n",
    "math_latex": [
      "\\displaystyle\\boldsymbol{Z}={\\rm MLP}\\left(\\boldsymbol{X}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times c}",
      "\\displaystyle\\boldsymbol{H}_{\\ell}=\\widehat{\\boldsymbol{A}}^{\\ell}\\boldsymbol{Z},\\ell=1,2,\\cdots,k",
      "\\displaystyle\\in\\mathbb{R}^{n\\times c}",
      "\\displaystyle\\boldsymbol{H}={\\rm stack}\\left(\\boldsymbol{Z},\\boldsymbol{H}_{1},\\cdots,\\boldsymbol{H}_{k}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times c}",
      "\\displaystyle\\boldsymbol{S}=\\sigma\\left(\\boldsymbol{H}\\boldsymbol{s}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times(k+1)\\times 1}",
      "\\displaystyle\\widetilde{\\boldsymbol{S}}={\\rm reshape}\\left(\\boldsymbol{S}\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times 1\\times(k+1)}",
      "\\displaystyle\\boldsymbol{X}_{out}={\\rm softmax}\\left({\\rm squeeze}\\left(\\widetilde{\\boldsymbol{S}}\\boldsymbol{H}\\right)\\right)",
      "\\displaystyle\\in\\mathbb{R}^{n\\times c},"
    ]
  },
  {
    "id": "S4.E9",
    "HTML": "<table id=\"S4.E9\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left\"><span class=\"ltx_tag ltx_tag_equation ltx_align_left\">(9)</span></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S4.E9.m1\" class=\"ltx_math_unparsed\" alttext=\"\\mathcal{L}=-\\sum_{i\\in V_{L}}\\sum_{p=1}^{c}\\boldsymbol{Y}_{[i,p]}\\ln{\\boldsymbol{X}_{out}}_{[i,p]},\" display=\"block\" intent=\":literal\"><semantics><mrow><mi class=\"ltx_font_mathcaligraphic\">ℒ</mi><mo rspace=\"0em\">=</mo><mo lspace=\"0em\" rspace=\"0.055em\">−</mo><mo movablelimits=\"false\" rspace=\"0em\">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>V</mi><mi>L</mi></msub></mrow></msub><mo movablelimits=\"false\">∑</mo><msub><mrow></mrow><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>c</mi></msup><mi>𝒀</mi><msub><mrow></mrow><mrow><mo stretchy=\"false\">[</mo><mi>i</mi><mo>,</mo><mi>p</mi><mo stretchy=\"false\">]</mo></mrow></msub><mi>ln</mi><mi>𝑿</mi><msub><mrow></mrow><mrow><mi>o</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>u</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>t</mi></mrow></msub><msub><mrow></mrow><mrow><mo stretchy=\"false\">[</mo><mi>i</mi><mo>,</mo><mi>p</mi><mo stretchy=\"false\">]</mo></mrow></msub><mo>,</mo></mrow><annotation encoding=\"application/x-tex\">\\mathcal{L}=-\\sum_{i\\in V_{L}}\\sum_{p=1}^{c}\\boldsymbol{Y}_{[i,p]}\\ln{\\boldsymbol{X}_{out}}_{[i,p]},</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td></tr></tbody>\n</table>\n",
    "math_latex": [
      "\\mathcal{L}=-\\sum_{i\\in V_{L}}\\sum_{p=1}^{c}\\boldsymbol{Y}_{[i,p]}\\ln{\\boldsymbol{X}_{out}}_{[i,p]},"
    ]
  }
]
