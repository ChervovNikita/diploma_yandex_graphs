+def _native_edges(edges, project_root):
+    """Exact V6 CPU edge recipe, before device transfer; original node IDs.
+
+    No labels/masks or alternate topology. Source files for the actual loaded
+    helpers are recorded and matched to the pinned producer/native snapshots.
+    """
+    import inspect
+    import torch
+    from torch_geometric.utils import to_undirected, remove_self_loops, add_self_loops
+
+    _verify(project_root, GRAPH_RECIPE_REFERENCE)
+    _verify(project_root, PUBLIC_PRODUCER_REFERENCE)
+    loaded = {}
+    for name, function in (("to_undirected", to_undirected),
+                           ("remove_self_loops", remove_self_loops),
+                           ("add_self_loops", add_self_loops)):
+        expected = PYG_HELPER_SOURCES[name]
+        _verify(project_root, expected)
+        source_path = Path(inspect.getfile(function)).resolve()
+        actual = _descriptor(source_path, str(source_path))
+        _require(actual["sha256"] == expected["sha256"] and actual["bytes"] == expected["bytes"],
+                 "Loaded native edge helper source differs: " + name)
+        loaded[name] = {"expected_source": expected, "loaded_source": actual}
+    edge = torch.from_numpy(edges.copy())
+    input_shape = list(edge.shape)
+    input_digest = hashlib.sha256(edge.numpy().tobytes()).hexdigest()
+    # These three statements are identical to frozen V6 common.load_data.
+    edge = to_undirected(edge)
+    edge, _ = remove_self_loops(edge)
+    edge, _ = add_self_loops(edge, num_nodes=24492)
+    preprocessing = {"schema": "amazon_G0_native_public_edge_identity_v1",
+                     "public_graph": PUBLIC_GRAPH, "features": "raw FP32 unchanged",
+                     "original_node_count": 24492, "node_identity": "original IDs0..24491",
+                     "input_edge_shape": input_shape, "input_edge_logical_sha256": input_digest,
+                     "edge_recipe": "to_undirected/remove_self_loops/add_self_loops",
+                     "edge_shape": list(edge.shape),
+                     "edge_logical_sha256": hashlib.sha256(edge.numpy().tobytes()).hexdigest(),
+                     "recipe_source": GRAPH_RECIPE_REFERENCE,
+                     "producer_source": PUBLIC_PRODUCER_REFERENCE, "loaded_helpers": loaded}
+    return edge.numpy().copy(), preprocessing
