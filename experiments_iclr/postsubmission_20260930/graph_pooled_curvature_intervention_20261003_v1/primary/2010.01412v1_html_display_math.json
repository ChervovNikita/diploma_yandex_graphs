    ]
  },
  {
    "index": 3,
    "id": "S2.Ex3",
    "alttext": [
      "{\\bm{\\epsilon}^{*}}(\\bm{w})\\triangleq\\argmax_{\\|\\bm{\\epsilon}\\|_{p}\\leq\\rho}L_{\\mathcal{S}}(\\bm{w}+\\bm{\\epsilon})\\approx\\argmax_{\\|\\bm{\\epsilon}\\|_{p}\\leq\\rho}L_{\\mathcal{S}}(\\bm{w})+\\bm{\\epsilon}^{T}\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})=\\argmax_{\\|\\bm{\\epsilon}\\|_{p}\\leq\\rho}\\bm{\\epsilon}^{T}\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})."
    ]
  },
  {
    "index": 4,
    "id": "S2.E2",
    "alttext": [
      "\\hat{\\bm{\\epsilon}}(\\bm{w})=\\rho\\mbox{ sign}\\left(\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})\\right)\\left|\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})\\right|^{q-1}/\\bigg(\\|\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})\\|_{q}^{q}\\bigg)^{1/p}"
    ]
  },
  {
    "index": 5,
    "id": "S2.Ex4",
    "alttext": [
      "\\begin{split}\\nabla_{\\bm{w}}L^{SAM}_{\\mathcal{S}}(\\bm{w})&amp;\\approx\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w}+\\hat{\\bm{\\epsilon}}(\\bm{w}))=\\frac{d(\\bm{w}+{\\hat{\\bm{\\epsilon}}(\\bm{w})})}{d\\bm{w}}\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})|_{\\bm{w}+\\hat{\\bm{\\epsilon}}(w)}\\\\\n&amp;={\\nabla_{w}L_{\\mathcal{S}}(\\bm{w})|_{\\bm{w}+\\hat{\\bm{\\epsilon}}(\\bm{w})}}+{\\frac{d\\hat{\\bm{\\epsilon}}(\\bm{w})}{d\\bm{w}}\\nabla_{\\bm{w}}L_{\\mathcal{S}}(\\bm{w})|_{\\bm{w}+\\hat{\\bm{\\epsilon}}(\\bm{w})}}.\\end{split}"
    ]
  },
  {
    "index": 6,
    "id": "S2.E3",
    "alttext": [
      "\\nabla_{\\bm{w}}L^{SAM}_{\\mathcal{S}}(\\bm{w})\\approx{\\nabla_{\\bm{w}}L_{\\mathcal{S}}(w)|_{\\bm{w}+\\hat{\\bm{\\epsilon}}(\\bm{w})}}."
    ]
  },
  {
    "index": 7,
    "id": "A1.E4",
    "alttext": [
      "L_{\\mathscr{D}}(\\bm{w})\\leq\\max_{\\|\\bm{\\epsilon}\\|_{2}\\leq\\rho}L_{\\mathcal{S}}(\\bm{w}+\\bm{\\epsilon})+\\sqrt{\\frac{\\frac{1}{4}k\\log\\left(1+\\frac{\\|\\bm{w}\\|_{2}^{2}}{\\rho^{2}}\\left(1+\\sqrt{\\frac{2\\log(2/\\delta)}{k}}\\right)^{2}\\right)+\\log\\frac{n}{\\delta}+\\tilde{O}(1)}{n-1}}"
    ]
  },
  {
    "index": 8,
    "id": "A1.E5",
    "alttext": [
      "\\mathbb{E}_{\\bm{w}\\sim\\mathscr{Q}}[L_{\\mathscr{D}}(\\bm{w})]\\leq\\mathbb{E}_{\\bm{w}\\sim\\mathscr{Q}}[L_{\\mathcal{S}}(\\bm{w})]+\\sqrt{\\frac{KL(\\mathscr{Q}||\\mathscr{P})+\\log\\frac{n}{\\delta}}{2(n-1)}}"
    ]
  },
  {
    "index": 9,
    "id": "A1.E6",
    "alttext": [
      "KL(\\mathscr{P}||\\mathscr{Q})=\\frac{1}{2}\\bigg[\\frac{k\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}}{\\sigma_{P}^{2}}-k+k\\log\\left(\\frac{\\sigma_{P}^{2}}{\\sigma_{Q}^{2}}\\right)\\bigg]"
    ]
  },
  {
    "index": 10,
    "id": "A1.E7",
    "alttext": [
      "\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}/k\\leq\\sigma_{P}^{2}\\leq\\exp(1/k)\\left(\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}/k\\right)"
    ]
  },
  {
    "index": 11,
    "id": "A1.EGx1",
    "alttext": [
      "\\displaystyle KL(\\mathscr{P}||\\mathscr{Q})",
      "\\displaystyle=\\frac{1}{2}\\bigg[\\frac{k\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}}{\\sigma_{P}^{2}}-k+k\\log\\left(\\frac{\\sigma_{P}^{2}}{\\sigma_{Q}^{2}}\\right)\\bigg]",
      "\\displaystyle\\leq\\frac{1}{2}\\bigg[\\frac{k\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}}{\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}/k}-k+k\\log\\left(\\frac{\\exp(1/k)\\left(\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}/k\\right)}{\\sigma_{Q}^{2}}\\right)\\bigg]",
      "\\displaystyle=\\frac{1}{2}\\bigg[k\\log\\left(\\frac{\\exp(1/k)\\left(\\sigma_{Q}^{2}+\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}/k\\right)}{\\sigma_{Q}^{2}}\\right)\\bigg]",
      "\\displaystyle=\\frac{1}{2}\\bigg[1+k\\log\\left(1+\\frac{\\|\\bm{\\mu}_{P}-\\bm{\\mu}_{Q}\\|_{2}^{2}}{k\\sigma_{Q}^{2}}\\right)\\bigg]=\\frac{1}{2}\\bigg[1+k\\log\\left(1+\\frac{\\|\\bm{w}\\|_{2}^{2}}{k\\sigma_{Q}^{2}}\\right)\\bigg]"
    ]
  },
  {
    "index": 12,
