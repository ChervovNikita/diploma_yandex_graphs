[
  {
    "id": "algorithm1.6.1",
    "visible_text": "Require: 𝒟s​t​r​e​a​m=(X1,Y1),(X2,Y2),…,(Xt,Yt),…;",
    "TeX": [
      "\\mathcal{D}_{stream}=(X_{1},Y_{1}),(X_{2},Y_{2}),\\ldots,(X_{t},Y_{t}),\\ldots"
    ]
  },
  {
    "id": "algorithm1.6.2",
    "visible_text": "Require: gW​(ϕθ​(x)) as a parametrized function;",
    "TeX": [
      "g_{W}(\\phi_{\\theta}(x))"
    ]
  },
  {
    "id": "algorithm1.6.3",
    "visible_text": "Require: α,β,ℒ,n as meta learning rate, inner learning rate, loss metric over (Xi,Yi) and total gradient updates;",
    "TeX": [
      "\\alpha,\\beta,\\mathcal{L},n",
      "(X_{i},Y_{i})"
    ]
  },
  {
    "id": "algorithm1.6.4",
    "visible_text": "Initialize RLN and TLN to θ and W;",
    "TeX": [
      "\\theta",
      "W"
    ]
  },
  {
    "id": "algorithm1.6.5",
    "visible_text": "for iterations 1,2,3,…,n do",
    "TeX": [
      "1,2,3,\\dots,n"
    ]
  },
  {
    "id": "algorithm1.6.6",
    "visible_text": "Sample trajectory (𝐗𝐭𝐫𝐚𝐣,𝐘𝐭𝐫𝐚𝐣)=(Xi+1,Yi+1)​…​(Xi+k,Yi+k)∼𝒟s​t​r​e​a​m;",
    "TeX": [
      "(\\mathbf{X_{traj}},\\mathbf{Y_{traj}})=(X_{i+1},Y_{i+1})\\ldots(X_{i+k},Y_{i+k})\\sim\\mathcal{D}_{stream}"
    ]
  },
  {
    "id": "algorithm1.6.7",
    "visible_text": "W0=W;",
    "TeX": [
      "W_{0}=W"
    ]
  },
  {
    "id": "algorithm1.6.8",
    "visible_text": "for j in 1,2,3,…,k do",
    "TeX": [
      "j",
      "1,2,3,\\ldots,k"
    ]
  },
  {
    "id": "algorithm1.6.9",
    "visible_text": "Wj=Wj−1−β​∇Wj−1(ℒ⁡(gWj−1​(ϕθ​(Xi+j)),Yi+j)CLOSE;",
    "TeX": [
      "W_{j}=W_{j-1}-\\beta\\nabla_{W_{j-1}}(\\mathcal{L}(g_{W_{j-1}}(\\phi_{\\theta}(X_{i+j})),Y_{i+j})"
    ]
  },
  {
    "id": "algorithm1.6.10",
    "visible_text": "end for",
    "TeX": []
  },
  {
    "id": "algorithm1.6.11",
    "visible_text": "(𝐗𝐫𝐚𝐧𝐝,𝐘𝐫𝐚𝐧𝐝)∼𝒟s​t​r​e​a​m; Sample a random batch of data",
    "TeX": [
      "(\\mathbf{X_{rand}},\\mathbf{Y_{rand}})\\sim\\mathcal{D}_{stream}"
    ]
  },
  {
    "id": "algorithm1.6.12",
    "visible_text": "(𝐗𝐦𝐞𝐭𝐚,𝐘𝐦𝐞𝐭𝐚)=(𝐗𝐫𝐚𝐧𝐝+𝐗𝐭𝐫𝐚𝐣,𝐘𝐫𝐚𝐧𝐝+𝐘𝐭𝐫𝐚𝐣);",
    "TeX": [
      "(\\mathbf{X_{meta}},\\mathbf{Y_{meta}})=(\\mathbf{X_{rand}}+\\mathbf{X_{traj}},\\mathbf{Y_{rand}}+\\mathbf{Y_{traj}})"
    ]
  },
  {
    "id": "algorithm1.6.13",
    "visible_text": "W,θ=(W,θ)−α​𝓇W,θ​ℒ​(gWk​(ϕθ​(𝐗𝐦𝐞𝐭𝐚)),𝐘𝐦𝐞𝐭𝐚);",
    "TeX": [
      "W,\\theta=(W,\\theta)-\\alpha\\mathcal{r}_{W,\\theta}\\mathcal{L}(g_{W_{k}}(\\phi_{\\theta}(\\mathbf{X_{meta}})),\\mathbf{Y_{meta}})"
    ]
  },
  {
    "id": "algorithm1.6.14",
    "visible_text": "end for",
    "TeX": []
  },
  {
    "id": "algorithm1.6.15",
