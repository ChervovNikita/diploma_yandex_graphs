[
  {
    "id": "alg1.l1",
    "visible_text": "1: Input: Performance threshold of proficiency, γ",
    "TeX": [
      "\\gamma"
    ]
  },
  {
    "id": "alg1.l2",
    "visible_text": "2: randomly initialize 𝐰1",
    "TeX": [
      "{\\mathbf{w}}_{1}"
    ]
  },
  {
    "id": "alg1.l3",
    "visible_text": "3: initialize the task buffer as empty, ℬ←[]",
    "TeX": [
      "\\mathcal{B}\\leftarrow[~]"
    ]
  },
  {
    "id": "alg1.l4",
    "visible_text": "4: for t=1,… do",
    "TeX": [
      "t=1,\\dots"
    ]
  },
  {
    "id": "alg1.l5",
    "visible_text": "5: initialize 𝒟t=∅",
    "TeX": [
      "\\mathcal{D}_{t}=\\emptyset"
    ]
  },
  {
    "id": "alg1.l6",
    "visible_text": "6: Add ℬ←ℬ+[𝒯t]",
    "TeX": [
      "\\mathcal{B}\\leftarrow\\mathcal{B}+[~\\mathcal{T}_{t}~]"
    ]
  },
  {
    "id": "alg1.l7",
    "visible_text": "7: while |𝒟𝒯t|<N do",
    "TeX": [
      "|\\mathcal{D}_{\\mathcal{T}_{t}}|<N"
    ]
  },
  {
    "id": "alg1.l8",
    "visible_text": "8: Append batch of n new datapoints {(𝐱,𝐲)} to 𝒟t",
    "TeX": [
      "n",
      "\\left\\{\\left(\\mathbf{x},\\mathbf{y}\\right)\\right\\}",
      "\\mathcal{D}_{t}"
    ]
  },
  {
    "id": "alg1.l9",
    "visible_text": "9: 𝐰t← Meta-Update(𝐰t,ℬ,t)",
    "TeX": [
      "{\\mathbf{w}}_{t}\\leftarrow",
      "({\\mathbf{w}}_{t},\\mathcal{B},t)"
    ]
  },
  {
    "id": "alg1.l10",
    "visible_text": "10: 𝐰~t←Update-Procedure​(𝐰t,𝒟t)",
    "TeX": [
      "\\tilde{{\\mathbf{w}}}_{t}\\leftarrow\\texttt{Update-Procedure}\\left({\\mathbf{w}}_{t},\\mathcal{D}_{t}\\right)"
    ]
  },
  {
    "id": "alg1.l11",
    "visible_text": "11: if ℒ⁡(𝒟ttest,𝐰~t)<γ then",
    "TeX": [
      "\\mathcal{L}\\left(\\mathcal{D}^{\\text{test}}_{t},\\tilde{{\\mathbf{w}}}_{t}\\right)<\\gamma"
    ]
  },
  {
    "id": "alg1.l12",
    "visible_text": "12: Record efficiency for task 𝒯t as |𝒟t| datapoints",
    "TeX": [
      "\\mathcal{T}_{t}",
      "|\\mathcal{D}_{t}|"
    ]
  },
  {
    "id": "alg1.l13",
    "visible_text": "13: end if",
    "TeX": []
  },
  {
    "id": "alg1.l14",
    "visible_text": "14: end while",
    "TeX": []
  },
  {
    "id": "alg1.l15",
    "visible_text": "15: Record final performance of 𝐰~t on test set 𝒟ttest for task t.",
    "TeX": [
      "\\tilde{{\\mathbf{w}}}_{t}",
      "\\mathcal{D}_{t}^{\\text{test}}",
      "t"
    ]
  },
  {
    "id": "alg1.l16",
    "visible_text": "16: 𝐰t+1←𝐰t",
    "TeX": [
      "{\\mathbf{w}}_{t+1}\\leftarrow{\\mathbf{w}}_{t}"
    ]
  },
  {
    "id": "alg1.l17",
    "visible_text": "17: end for",
    "TeX": []
  },
  {
    "id": "alg2.l1",
    "visible_text": "1: Input: Hyperparameters parameters α,η",
    "TeX": [
      "\\alpha,\\eta"
    ]
  },
  {
    "id": "alg2.l2",
    "visible_text": "2: function Meta-Update(𝐰,ℬ,t)",
    "TeX": [
      "({\\mathbf{w}},\\mathcal{B},t)"
    ]
  },
  {
    "id": "alg2.l3",
    "visible_text": "3: for nm=1,…,Nmeta steps do",
    "TeX": [
      "n_{\\text{m}}=1,\\dots,N_{\\text{meta}}"
    ]
  },
  {
    "id": "alg2.l4",
    "visible_text": "4: Sample task 𝒯k: k∼νt​(⋅) // (or a minibatch of tasks)",
    "TeX": [
      "\\mathcal{T}_{k}",
      "k\\sim\\nu^{t}(\\cdot)"
    ]
  },
  {
    "id": "alg2.l5",
    "visible_text": "5: Sample minibatches 𝒟ktr, 𝒟kval uniformly from 𝒟k",
    "TeX": [
      "\\mathcal{D}_{k}^{\\text{tr}}",
      "\\mathcal{D}_{k}^{\\text{val}}",
      "\\mathcal{D}_{k}"
    ]
  },
  {
    "id": "alg2.l6",
    "visible_text": "6: Compute gradient 𝐠t using 𝒟ktr, 𝒟kval, and Eq. 5",
    "TeX": [
      "\\mathbf{g}_{t}",
      "\\mathcal{D}_{k}^{\\text{tr}}",
      "\\mathcal{D}_{k}^{\\text{val}}"
    ]
  },
  {
    "id": "alg2.l7",
    "visible_text": "7: Update parameters 𝐰←𝐰−η​𝐠t // (or use Adam)",
    "TeX": [
      "{\\mathbf{w}}\\leftarrow{\\mathbf{w}}-\\eta\\ \\mathbf{g}_{t}"
    ]
  },
  {
    "id": "alg2.l8",
    "visible_text": "8: end for",
    "TeX": []
  },
  {
    "id": "alg2.l9",
    "visible_text": "9: Return 𝐰",
    "TeX": [
      "{\\mathbf{w}}"
    ]
  },
  {
    "id": "alg2.l10",
    "visible_text": "10: end function",
    "TeX": []
  },
  {
    "id": "alg2.l11",
    "visible_text": "11: function Update-Procedure(𝐰𝙲𝙻𝙾𝚂𝙴, OPEN𝒟)",
    "TeX": [
      "({\\mathbf{w}}",
      "\\mathcal{D})"
    ]
  },
  {
    "id": "alg2.l12",
    "visible_text": "12: Initialize 𝐰~←𝐰",
    "TeX": [
      "\\tilde{{\\mathbf{w}}}\\leftarrow{\\mathbf{w}}"
    ]
  },
  {
    "id": "alg2.l13",
    "visible_text": "13: for ng=1,…,Ngrad steps do",
    "TeX": [
      "n_{\\text{g}}=1,\\dots,N_{\\text{grad}}"
    ]
  },
  {
    "id": "alg2.l14",
    "visible_text": "14: 𝐰~←𝐰~−α∇ℒ(𝒟,𝐰~)",
    "TeX": [
      "\\tilde{{\\mathbf{w}}}\\leftarrow\\tilde{{\\mathbf{w}}}-\\alpha\\nabla\\mathcal{L}(\\mathcal{D},\\tilde{{\\mathbf{w}}})"
    ]
  },
  {
    "id": "alg2.l15",
    "visible_text": "15: end for",
    "TeX": []
  },
  {
    "id": "alg2.l16",
    "visible_text": "16: Return 𝐰~",
    "TeX": [
      "\\tilde{{\\mathbf{w}}}"
    ]
  },
  {
    "id": "alg2.l17",
    "visible_text": "17: end function",
    "TeX": []
  }
]
