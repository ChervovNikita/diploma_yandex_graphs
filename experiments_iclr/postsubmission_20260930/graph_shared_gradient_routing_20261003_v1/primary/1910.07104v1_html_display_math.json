[
  {
    "index": 0,
    "id": "S2.E1.m1",
    "alttext": "L_{t}(w)=\\sum_{(x,y)\\in T_{t}}L_{(x,y)}(w),"
  },
  {
    "index": 1,
    "id": "S2.E2.m1",
    "alttext": "L_{(x,y)}(w)=\\ell(y,f(x;w)),"
  },
  {
    "index": 2,
    "id": "S2.E3.m1",
    "alttext": "\\ell(y,f(x;w))=-\\sum_{j=1}^{c}y_{j}\\log a_{j},"
  },
  {
    "index": 3,
    "id": "S2.E4.m1",
    "alttext": "\\nabla L_{(x,y)}(w)=\\nabla f(x;w)\\ell^{\\prime}(y,f(x;w)),"
  },
  {
    "index": 4,
    "id": "S2.E5.m1",
    "alttext": "\\nabla f(x;w)=[\\nabla f_{1}(x;w);\\ldots;\\nabla f_{c}(x;w),],"
  },
  {
    "index": 5,
    "id": "S2.E6.m1",
    "alttext": "\\ell^{\\prime}(y,f(x;w))=[a_{1}-y_{1},\\ldots,a_{c}-y_{c}]^{\\top},"
  },
  {
    "index": 6,
    "id": "S3.E7.m1",
    "alttext": "\\tilde{g}\\perp\\nabla f_{j}(x;w),\\quad\\forall x\\in T_{A},j=1\\ldots c~."
  },
  {
    "index": 7,
    "id": "S3.E8.m1",
    "alttext": "\\tilde{g}\\perp\\nabla f_{j}(x;w^{*}_{A}),\\quad\\forall x\\in T_{A},j=1\\ldots c,"
  },
  {
    "index": 8,
    "id": "S3.Ex1.m1",
    "alttext": "S=\\mathrm{span}\\{\\nabla f_{k}(x,{w^{*}_{A}})~|~(x,y)\\in T_{A}\\wedge k\\in[1,c]\\wedge y_{k}=1\\}."
  },
  {
    "index": 9,
    "id": "S3.E9.m1",
    "alttext": "\\tilde{g}=g-\\sum_{i=1}^{n_{A}}\\mathrm{proj}_{v_{i}}(g)~."
  }
]
