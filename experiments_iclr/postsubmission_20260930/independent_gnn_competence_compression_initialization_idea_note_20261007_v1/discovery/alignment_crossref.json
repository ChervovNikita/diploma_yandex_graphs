978-1-4302-6104-9_6"}},"issued":{"date-parts":[[2013]]},"ISBN":["9781430261032","9781430261049"],"references-count":0,"URL":"https:\/\/doi.org\/10.1007\/978-1-4302-6104-9_6","published":{"date-parts":[[2013]]}},{"indexed":{"date-parts":[[2024,5,7]],"date-time":"2024-05-07T06:10:01Z","timestamp":1715062201814},"edition-number":"1","reference-count":0,"publisher":"Wiley","isbn-type":[{"value":"9781119284970","type":"print"},{"value":"9781119285021","type":"electronic"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2016,12,12]]},"DOI":"10.1002\/9781119285021.ch9a","type":"other","created":{"date-parts":[[2016,12,14]],"date-time":"2016-12-14T19:11:37Z","timestamp":1481742697000},"page":"243-244","source":"Crossref","is-referenced-by-count":0,"title":["Connected Lab 6"],"prefix":"10.1002","member":"311","published-online":{"date-parts":[[2016,11,28]]},"container-title":["Professional Git\u00ae"],"language":"en","link":[{"URL":"https:\/\/api.wiley.com\/onlinelibrary\/tdm\/v1\/articles\/10.1002%2F9781119285021.ch9a","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/onlinelibrary.wiley.com\/doi\/pdf\/10.1002\/9781119285021.ch9a","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,8,26]],"date-time":"2023-08-26T16:15:30Z","timestamp":1693066530000},"score":26.437565,"resource":{"primary":{"URL":"https:\/\/onlinelibrary.wiley.com\/doi\/10.1002\/9781119285021.ch9a"}},"subtitle":["Practicing with Merging"],"issued":{"date-parts":[[2016,11,28]]},"ISBN":["9781119284970","9781119285021"],"references-count":0,"alternative-id":["10.1002\/9781119285021.ch9a","10.1002\/9781119285021"],"URL":"https:\/\/doi.org\/10.1002\/9781119285021.ch9a","archive":["Portico"],"published":{"date-parts":[[2016,11,28]]}},{"indexed":{"date-parts":[[2026,3,17]],"date-time":"2026-03-17T15:12:27Z","timestamp":1773760347978,"version":"3.50.1"},"posted":{"date-parts":[[2018,7,25]]},"group-title":"PHYSICAL SCIENCES","reference-count":0,"publisher":"MDPI AG","license":[{"start":{"date-parts":[[2018,7,25]],"date-time":"2018-07-25T00:00:00Z","timestamp":1532476800000},"content-version":"unspecified","delay-in-days":0,"URL":"http:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"accepted":{"date-parts":[[2018,7,24]]},"abstract":"<jats:p>In this paper, the connections between quantum non-locality and permutation symmetries areexplored. This includes two types of symmetries: permutation across a superposition and permutationof qubits in a quantum system. An algorithm is proposed for nding the separability class ofa quantum state using a method based on factorizing an arbitrary multipartite state into possiblepartitions, cyclically permuting qubits of the vectors in a superposition to check which separabilityclass it falls into and thereafter using a reduced density-matrix analysis of the system is proposed.For the case of mixed quantum states, conditions for separability are found in terms of the partialtransposition of the density matrices of the quantum system. One of these conditions turns out tobe the Partial Positive Transpose (PPT) condition. A graphical method for analyzing separabilityis also proposed. The concept of permutation of qubits is shown to be useful in dening a newentanglement measure in the `engle'.<\/jats:p>","DOI":"10.20944\/preprints201807.0482.v1","type":"posted-content","created":{"date-parts":[[2018,8,7]],"date-time":"2018-08-07T08:26:16Z","timestamp":1533630376000},"source":"Crossref","is-referenced-by-count":1,"title":["Quantum Correlations and Permutation Symmetries"],"prefix":"10.20944","author":[{"given":"Mrittunjoy Guha","family":"Majumdar","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"1968","deposited":{"date-parts":[[2018,10,31]],"date-time":"