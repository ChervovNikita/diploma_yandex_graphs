  },
  {
    "index": 7,
    "equation_element_id": "S3.E8",
    "alttext": "\\lVert Sx-Q{S_{c}}Px\\rVert_{L}\\leq\\epsilon_{L,Q,P,\\mathcal{R}}\\lVert x\\rVert_{L}\\left(C_{S}+C_{\\Pi}\\right)",
