  {
    "index": 6,
    "equation_element_id": "S3.E7",
    "alttext": "\\epsilon_{L,Q,P,\\mathcal{R}}=\\sup_{x\\in\\mathcal{R},\\,\\|x\\|_{L}=1}\\lVert x-QPx\\rVert_{L}",
