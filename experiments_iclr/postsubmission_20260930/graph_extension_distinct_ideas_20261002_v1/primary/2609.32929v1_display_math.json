[
  {
    "index": 0,
    "equation_element_id": "S2.E1",
    "alttext": "W=D^{-\\beta}AD^{\\beta-1},",
    "math_id": "S2.E1.m1"
  },
  {
    "index": 1,
    "equation_element_id": "S2.E2",
    "alttext": "z_{i}(t+1)=f_{i}\\left(\\alpha s_{i}+(1-\\alpha)\\sum_{j}w_{ij}z_{j}(t)\\right),",
    "math_id": "S2.E2.m1"
  },
  {
    "index": 2,
    "equation_element_id": "S2.E3",
    "alttext": "z(t+1)=F\\left(\\alpha s+(1-\\alpha)Wz(t)\\right),",
    "math_id": "S2.E3.m1"
  },
  {
    "index": 3,
    "equation_element_id": "S2.E4",
    "alttext": "\\Psi_{W}(r):=\\frac{\\|D^{\\beta}r\\|_{1}}{1-K(1-\\alpha)}=\\frac{1}{1-K(1-\\alpha)}\\sum_{j=1}^{n}d(j)^{\\beta}|r_{j}|.",
    "math_id": "S2.E4.m1"
  },
  {
    "index": 4,
    "equation_element_id": "S2.Ex4",
    "alttext": "\\Psi_{W_{t}}(r_{t-1})-\\Psi_{W_{t-1}}(r_{t-1})\\leq 2\\epsilon.",
    "math_id": "S2.Ex4.m1"
  },
  {
    "index": 5,
    "equation_element_id": "A1.Ex7",
    "alttext": "\\|D^{\\beta-1}z^{*}\\|_{\\infty}=\\max_{i}d(i)^{\\beta-1}|z_{i}^{*}|\\leq\\max_{i}|z_{i}^{*}|\\leq B_{z}.\\qed",
    "math_id": "A1.Ex7.m1"
  },
  {
    "index": 6,
    "equation_element_id": "A1.Ex11",
    "alttext": "\\|D^{\\beta-1}z^{*}\\|_{\\infty}\\leq\\frac{\\max_{i}|f_{i}(0)|+K\\alpha\\|s\\|_{\\infty}}{1-K(1-\\alpha)}.",
    "math_id": "A1.Ex11.m1"
  },
  {
    "index": 7,
    "equation_element_id": "A1.Ex12",
    "alttext": "|z^{*}_{i}|\\leq|f_{i}(0)|+K|x_{i}|\\leq\\max_{j}|f_{j}(0)|+K\\alpha|s_{i}|+K(1-\\alpha)|(Wz^{*})_{i}|.",
    "math_id": "A1.Ex12.m1"
  },
  {
    "index": 8,
    "equation_element_id": "A1.Ex13",
    "alttext": "\\|z^{*}\\|_{D,\\infty}\\leq\\max_{j}|f_{j}(0)|+K\\alpha\\|s\\|_{\\infty}+K(1-\\alpha)\\|z^{*}\\|_{D,\\infty}.",
    "math_id": "A1.Ex13.m1"
  },
  {
    "index": 9,
    "equation_element_id": "A1.Ex20",
    "alttext": "|z_{i}-z_{i}^{*}|\\leq\\frac{d(i)^{1-\\beta}}{1-K(1-\\alpha)}\\|D^{\\beta-1}r\\|_{\\infty}.\\qed",
    "math_id": "A1.Ex20.m1"
  },
  {
    "index": 10,
    "equation_element_id": "A1.Ex23",
    "alttext": "|r^{\\prime}_{j}|=|f_{j}(y^{\\prime}_{j})-z_{j}|\\leq|f_{j}(y^{\\prime}_{j})-f_{j}(y_{j})|+|f_{j}(y_{j})-z_{j}|=K(1-\\alpha)w_{ji}|r_{i}|+|r_{j}|.",
    "math_id": "A1.Ex23.m1"
  },
  {
    "index": 11,
    "equation_element_id": "A1.Ex24",
    "alttext": "|r^{\\prime}_{i}|=|f_{i}(y^{\\prime}_{i})-z_{i}-r_{i}|=|f_{i}(y^{\\prime}_{i})-f_{i}(y_{i})|\\leq K|y^{\\prime}_{i}-y_{i}|=K(1-\\alpha)w_{ii}|r_{i}|.",
    "math_id": "A1.Ex24.m1"
  },
  {
    "index": 12,
    "equation_element_id": "A1.Ex25",
    "alttext": "\\frac{z^{\\prime}_{u}}{(d^{\\prime}_{u})^{1-\\beta}}=\\frac{z_{u}}{d_{u}^{1-\\beta}}=x_{u},\\qquad\\frac{z^{\\prime}_{v}}{(d^{\\prime}_{v})^{1-\\beta}}=\\frac{z_{v}}{d_{v}^{1-\\beta}}=x_{v}.",
    "math_id": "A1.Ex25.m1"
  },
  {
    "index": 13,
    "equation_element_id": "A1.Ex28",
    "alttext": "d^{1-\\beta}|(d+\\delta)^{\\beta}-d^{\\beta}|=d^{1-\\beta}d^{\\beta}|(1+x)^{\\beta}-1|=d|(1+x)^{\\beta}-1|.",
    "math_id": "A1.Ex28.m1"
  },
  {
    "index": 14,
    "equation_element_id": "A1.Ex29",
    "alttext": "y^{\\prime}_{v}-y_{t-1,v}=(1-\\alpha)\\left[\\left(\\frac{1}{(b+\\sigma)^{\\beta}}-\\frac{1}{b^{\\beta}}\\right)S_{v}+\\frac{\\sigma x_{u}}{(b+\\sigma)^{\\beta}}\\right].",
    "math_id": "A1.Ex29.m1"
  },
  {
    "index": 15,
    "equation_element_id": "A1.Ex33",
    "alttext": "(b+\\sigma)^{\\beta}\\left|(b+\\sigma)^{1-\\beta}-b^{1-\\beta}\\right||x_{v}|.",
    "math_id": "A1.Ex33.m1"
  },
  {
    "index": 16,
    "equation_element_id": "A1.Ex35",
    "alttext": "d_{t}(v)^{\\beta}|r^{\\prime}_{t,v}-r_{t-1,v}|=(b+\\sigma)^{\\beta}|r^{\\prime}_{t,v}-r_{t-1,v}|\\leq\\left(1+2K(1-\\alpha)\\right)X.",
    "math_id": "A1.Ex35.m1"
  },
  {
    "index": 17,
    "equation_element_id": "A1.Ex40",
    "alttext": "d_{t-1}(i)^{1-\\beta}\\left((d_{t-1}(i)+1)^{\\beta}-d_{t-1}(i)^{\\beta}\\right)\\leq 1.",
    "math_id": "A1.Ex40.m1"
  },
  {
    "index": 18,
    "equation_element_id": "A1.Ex43",
    "alttext": "\\frac{\\Psi_{W_{0}}(r^{\\mathrm{start}}_{0})-\\Psi_{W_{0}}(r_{0})}{\\left(1-K(1-\\alpha)\\right)\\epsilon}.",
    "math_id": "A1.Ex43.m1"
  },
  {
    "index": 19,
    "equation_element_id": "A1.Ex49",
    "alttext": "T_{\\mathrm{total}}\\leq T_{\\mathrm{init}}+\\frac{2k}{1-K(1-\\alpha)}+\\frac{2\\left(1+2K(1-\\alpha)\\right)(B_{z}+\\epsilon)}{\\left(1-K(1-\\alpha)\\right)^{2}\\epsilon}k.\\qed",
    "math_id": "A1.Ex49.m1"
  },
  {
    "index": 20,
    "equation_element_id": "A2.E5",
    "alttext": "z^{*}=\\left[I-(1-\\alpha)W\\right]^{-1}\\alpha s.",
    "math_id": "A2.E5.m1"
  },
  {
    "index": 21,
    "equation_element_id": "A2.Ex57",
    "alttext": "W_{+}=D_{+}^{-\\beta}A_{+}D_{+}^{\\beta-1}=(I+E\\Lambda E^{T})W(I+E\\Gamma E^{T})+EHE^{T}.",
    "math_id": "A2.Ex57.m1"
  },
  {
    "index": 22,
    "equation_element_id": "A2.Ex58",
    "alttext": "W_{+}-W=E\\Lambda E^{T}W(I+E\\Gamma E^{T})+WE\\Gamma E^{T}+EHE^{T}.",
    "math_id": "A2.Ex58.m1"
  },
  {
    "index": 23,
    "equation_element_id": "A2.Ex59",
    "alttext": "U=\\begin{bmatrix}E&WE\\Gamma\\end{bmatrix}\\in\\mathbb{R}^{n\\times 4}",
    "math_id": "A2.Ex59.m1"
  },
  {
    "index": 24,
    "equation_element_id": "A2.Ex60",
    "alttext": "V^{T}=\\begin{bmatrix}\\Lambda E^{T}W(I+E\\Gamma E^{T})+HE^{T}\\\\\nE^{T}\\end{bmatrix}\\in\\mathbb{R}^{4\\times n}.",
    "math_id": "A2.Ex60.m1"
  },
  {
    "index": 25,
    "equation_element_id": "A2.E6",
    "alttext": "B^{-1}=M-YG\\mathcal{V}^{T}M.",
    "math_id": "A2.E6.m1"
  },
  {
    "index": 26,
    "equation_element_id": "A2.Ex61",
    "alttext": "B^{-1}=M-YG\\mathcal{V}^{T}M.",
    "math_id": "A2.Ex61.m1"
  },
  {
    "index": 27,
    "equation_element_id": "A2.Ex62",
    "alttext": "Z=\\begin{bmatrix}B^{-1}E&\\frac{1}{1-\\alpha}(B^{-1}E-E)\\Gamma\\end{bmatrix}.",
    "math_id": "A2.Ex62.m1"
  },
  {
    "index": 28,
    "equation_element_id": "A2.Ex63",
    "alttext": "B^{-1}E=ME-YG\\mathcal{V}^{T}ME.",
    "math_id": "A2.Ex63.m1"
  },
  {
    "index": 29,
    "equation_element_id": "A2.Ex64",
    "alttext": "B_{+}^{-1}=B^{-1}-ZS^{-1}V^{T}B^{-1}.",
    "math_id": "A2.Ex64.m1"
  },
  {
    "index": 30,
    "equation_element_id": "A2.Ex65",
    "alttext": "MWE=\\frac{1}{1-\\alpha}(ME-E)-\\frac{1}{1-\\alpha}Y\\mathcal{V}^{T}E.",
    "math_id": "A2.Ex65.m1"
  },
  {
    "index": 31,
    "equation_element_id": "A2.Ex66",
    "alttext": "MU=\\begin{bmatrix}ME&\\left(\\frac{1}{1-\\alpha}(ME-E)-\\frac{1}{1-\\alpha}Y\\mathcal{V}^{T}E\\right)\\Gamma\\end{bmatrix}.",
    "math_id": "A2.Ex66.m1"
  },
  {
    "index": 32,
    "equation_element_id": "A2.Ex68",
    "alttext": "C:=\\mathcal{V}^{T}MU\\in\\mathbb{R}^{4k\\times 4},\\qquad R:=V^{T}Y\\in\\mathbb{R}^{4\\times 4k},\\qquad Q:=I_{4}+V^{T}MU\\in\\mathbb{R}^{4\\times 4}.",
    "math_id": "A2.Ex68.m1"
  },
  {
    "index": 33,
    "equation_element_id": "A2.Ex69",
    "alttext": "I_{4(k+1)}+\\mathcal{V}_{+}^{T}Y_{+}=\\begin{bmatrix}G^{-1}&C\\\\\nR&Q\\end{bmatrix}.",
    "math_id": "A2.Ex69.m1"
  },
  {
    "index": 34,
    "equation_element_id": "A2.Ex70",
    "alttext": "G_{+}=\\begin{bmatrix}G+GC\\Sigma^{-1}RG&-GC\\Sigma^{-1}\\\\\n-\\Sigma^{-1}RG&\\Sigma^{-1}\\end{bmatrix}.",
    "math_id": "A2.Ex70.m1"
  },
  {
    "index": 35,
    "equation_element_id": "A2.Ex71",
    "alttext": "U=\\begin{bmatrix}E&C\\end{bmatrix},\\qquad V^{T}=\\begin{bmatrix}R\\\\\nE^{T}\\end{bmatrix}.",
    "math_id": "A2.Ex71.m1"
  },
  {
    "index": 36,
    "equation_element_id": "A2.Ex72",
    "alttext": "(A^{\\prime})^{-1}=A^{-1}-A^{-1}U\\left(I_{2k}+V^{T}A^{-1}U\\right)^{-1}V^{T}A^{-1}.",
    "math_id": "A2.Ex72.m1"
  }
]
