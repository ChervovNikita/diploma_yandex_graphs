      "\\displaystyle\\left(\\mathbf{A}^{\\prime},\\mathbf{X}^{\\prime}\\right)\\sim\\operatorname{CSBM}\\left(n^{\\prime},p^{\\prime},q^{\\prime},\\bm{\\mu},\\bm{\\nu}\\right)."
    ]
  },
  {
    "index": 3,
    "id": "Sx2.EGx4",
    "alttext": [
