    ]
  },
  {
    "index": 9,
    "id": "Sx7.EGx9",
    "alttext": [
      "\\displaystyle m(i)=E\\left(\\tilde{\\mathbf{X}}_{i}\\right)=\\left\\{\\begin{array}[]{ll}\\frac{p\\bm{\\mu}+q\\bm{\\nu}}{p+q}(1+o(1)),&amp;\\text{for }i\\in C_{0},\\\\\n\\frac{q\\bm{\\mu}+p\\bm{\\nu}}{p+q}(1+o(1)),&amp;\\text{for }i\\in C_{1},\\\\\n\\end{array}\\right."
    ]
  },
  {
    "index": 10,
    "id": "Sx7.EGx10",
    "alttext": [
      "\\displaystyle\\left|\\left(\\tilde{\\mathbf{X}}_{i}-m(i)\\right)\\cdot\\mathbf{w}\\right|=O\\left(\\sqrt{\\frac{\\log n}{dn(p+q)}}\\right)."
    ]
  },
  {
    "index": 11,
    "id": "Sx7.EGx11",
    "alttext": [
      "\\displaystyle\\begin{aligned} \\left\\langle\\tilde{\\mathbf{X}}_{i},\\mathbf{w}^{*}\\right\\rangle+b^{*}&amp;=\\frac{\\left\\langle p\\bm{\\mu}+q\\bm{\\nu},\\mathbf{w}^{*}\\right\\rangle}{p+q}(1+o(1))+O\\left(\\left\\|\\mathbf{w}^{*}\\right\\|\\sqrt{\\frac{\\log n}{dn(p+q)}}\\right)-\\frac{1}{2}\\left\\langle\\bm{\\nu}+\\bm{\\mu},\\mathbf{w}^{*}\\right\\rangle\\\\\n&amp;=\\frac{\\left\\langle 2p\\bm{\\mu}+2q\\bm{\\nu}-\\left(p+q\\right)(\\bm{\\mu}+\\bm{\\nu}),\\mathbf{w}^{*}\\right\\rangle}{p+q}(1+o(1))+o\\left(\\left\\|\\mathbf{w}^{*}\\right\\|\\right)\\\\\n&amp;=\\frac{p-q}{2\\left(p+q\\right)}\\langle\\bm{\\mu}-\\bm{\\nu},\\mathbf{w}^{*}\\rangle(1+o(1))+o\\left(\\left\\|\\mathbf{w}^{*}\\right\\|\\right)\\\\\n&amp;=-\\frac{R\\left(p-q\\right)}{2\\left(p+q\\right)}\\|\\bm{\\mu}-\\bm{\\nu}\\|(1+o(1))&lt;0.\\end{aligned}"
    ]
  },
  {
    "index": 12,
    "id": "Sx7.EGx12",
    "alttext": [
      "\\displaystyle\\left\\langle\\tilde{\\mathbf{X}}_{i},\\mathbf{w}^{*}\\right\\rangle+b^{*}=-\\frac{R(q-p)}{2(p+q)}\\|\\bm{\\mu}-\\bm{\\nu}\\|(1+o(1))&gt;0."
    ]
  },
  {
    "index": 13,
    "id": "Sx7.EGx13",
    "alttext": [
      "\\displaystyle\\left\\langle\\tilde{\\mathbf{X}}_{i},\\mathbf{w}^{*}\\right\\rangle+b^{*}=\\begin{cases}-\\frac{R(p^{\\prime}-q^{\\prime})}{2(p^{\\prime}+q^{\\prime})}\\|\\bm{\\mu}-\\bm{\\nu}\\|(1+o(1))&gt;0,&amp;\\text{for }i\\in C_{0},\\\\\n-\\frac{R(q^{\\prime}-p^{\\prime})}{2(p^{\\prime}+q^{\\prime})}\\|\\bm{\\mu}-\\bm{\\nu}\\|(1+o(1))&lt;0,&amp;\\text{for }i\\in C_{1}.\\\\\n\\end{cases}"
    ]
  },
  {
