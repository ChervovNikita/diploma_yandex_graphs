[
  {
    "tag": "div",
    "id": "alg1.l1",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Initialize to [MATH 0]"
  },
  {
    "tag": "div",
    "id": "alg1.l2",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "[MATH \\mathbf{B}=\\mathbf{0}]"
  },
  {
    "tag": "div",
    "id": "alg1.l3",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "for [MATH t=1,...,T] do"
  },
  {
    "tag": "div",
    "id": "alg1.l4",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Combine current low-rank estimate, [MATH \\mathbf{B}] , with new activities, [MATH \\mathbf{b}_{t}=\\mathbf{a}_{t}] , or new gradients, [MATH \\mathbf{b}_{t}=\\mathbf{g}_{t}]"
  },
  {
    "tag": "div",
    "id": "alg1.l5",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Could combine with several vectors, if available"
  },
  {
    "tag": "div",
    "id": "alg1.l6",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "[MATH \\mathbf{B}^{\\prime}=\\begin{pmatrix}\\mathbf{B}&\\mathbf{b}_{t}\\end{pmatrix}]"
  },
  {
    "tag": "div",
    "id": "alg1.l7",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "New low-rank estimate from top [MATH n_{\\text{kfac}}] components of SVD"
  },
  {
    "tag": "div",
    "id": "alg1.l8",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "[MATH \\mathbf{V}] doesn’t matter as its just a rotation"
  },
  {
    "tag": "div",
    "id": "alg1.l9",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "[MATH \\mathbf{U},\\mathbf{S},\\mathbf{V}^{T}=\\text{svd}(\\mathbf{B}^{\\prime})]"
  },
  {
    "tag": "div",
    "id": "alg1.l10",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "[MATH \\mathbf{B}\\leftarrow\\mathbf{U}[:,:n_{\\text{kfac}}]\\mathbf{S}[:n_{\\text{kfac}},:n_{\\text{kfac}}]]"
  },
  {
    "tag": "div",
    "id": "alg1.l11",
    "ancestors": [
      "alg1.4",
      "alg1",
      "A5.SS1",
      "A5"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "end for"
  },
  {
    "tag": "div",
    "id": "alg2.l1",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Initialize prior precision [MATH \\lambda] , learning rate [MATH \\eta] , optimization steps [MATH M]"
  },
  {
    "tag": "div",
    "id": "alg2.l2",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Obtain [MATH \\theta_{\\text{MAP}}] from a fine-tuned checkpoint, pre-compute [MATH \\log\\operatorname{P}\\left(\\mathbf{y}\\middle|\\mathbf{X},{\\bm{\\theta}}\\right)] and Fisher [MATH \\mathbf{F}]"
  },
  {
    "tag": "div",
    "id": "alg2.l3",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "for [MATH step=1,...,M] do"
  },
  {
    "tag": "div",
    "id": "alg2.l4",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Compute posterior covariance [MATH \\mathbf{\\Sigma}=\\mathbf{F}+\\lambda\\mathbf{I}]"
  },
  {
    "tag": "div",
    "id": "alg2.l5",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Calculate [MATH \\mathcal{L}(\\mathbf{y},\\mathbf{X};{\\bm{\\theta}})=\\log\\operatorname{P}\\left(\\mathbf{y}\\middle|\\mathbf{X},{\\bm{\\theta}}\\right)+\\log\\operatorname{P}\\left({\\bm{\\theta}}\\right)=\\log\\operatorname{P}\\left(\\mathbf{y}\\middle|\\mathbf{X},{\\bm{\\theta}}\\right)+\\lambda||{\\bm{\\theta}}_{\\text{MAP}}||_{2}^{2}]"
  },
  {
    "tag": "div",
    "id": "alg2.l6",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Perform a gradient step with respect to [MATH \\lambda] to maximize log model evidence (Eq. 14 ): [MATH \\lambda\\leftarrow\\lambda+\\eta\\nabla_{\\lambda}\\big(\\mathcal{L}(\\mathbf{y},\\mathbf{X};{{\\bm{\\theta}}_{\\text{MAP}}})+\\tfrac{1}{2}\\log|\\mathbf{\\Sigma}|\\big)]"
  },
  {
    "tag": "div",
    "id": "alg2.l7",
    "ancestors": [
      "alg2.4",
      "alg2",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "end for"
  },
  {
    "tag": "div",
    "id": "alg3.l1",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Initialize prior precision [MATH \\lambda] , learning rate [MATH \\eta] , batch size [MATH b] , validation set [MATH (\\mathbf{X},\\mathbf{y})]"
  },
  {
    "tag": "div",
    "id": "alg3.l2",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Obtain [MATH {\\bm{\\theta}}_{\\text{MAP}}] from a fine-tuned checkpoint, pre-compute mean [MATH f_{{\\bm{\\theta}}_{\\text{MAP}}}] , Jacobian [MATH \\mathbf{J}=\\nabla_{\\bm{\\theta}}f_{{\\bm{\\theta}}}(\\mathbf{X})|_{{\\bm{\\theta}}_{\\text{MAP}}}] , Fisher [MATH \\mathbf{F}]"
  },
  {
    "tag": "div",
    "id": "alg3.l3",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "for [MATH step=1,...,M] do"
  },
  {
    "tag": "div",
    "id": "alg3.l4",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Randomly sample a batch of validation data [MATH \\mathbf{X}_{b},\\mathbf{y}_{b}] with corresponding Jacobian [MATH \\mathbf{J}_{b}]"
  },
  {
    "tag": "div",
    "id": "alg3.l5",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Compute posterior covariance [MATH \\mathbf{\\Sigma}=\\mathbf{F}+\\lambda\\mathbf{I}]"
  },
  {
    "tag": "div",
    "id": "alg3.l6",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Calculate batch logits covariance [MATH \\mathbf{\\Lambda}_{b}=\\mathbf{J}_{b}^{T}\\mathbf{\\Sigma}\\mathbf{J}_{b}] and Cholesky [MATH \\mathbf{\\Lambda}_{b}=\\mathbf{L}_{b}\\mathbf{L}_{b}^{T}]"
  },
  {
    "tag": "div",
    "id": "alg3.l7",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Obtain batch Bayesian model average [MATH \\tilde{f}_{\\bm{\\theta}}(\\mathbf{X}_{b})=f_{{\\bm{\\theta}}_{\\text{MAP}}}(\\mathbf{X}_{b})+\\mathbf{L}_{b}\\bm{\\xi}]"
  },
  {
    "tag": "div",
    "id": "alg3.l8",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Evaluate validation likelihood [MATH \\operatorname{P}\\left(\\mathbf{y}_{b}\\middle|\\mathbf{X}_{b},{\\bm{\\theta}}\\right)=\\text{Categorical}\\big(\\mathbf{y}_{b};\\operatorname{softmax}(\\tilde{f}_{\\bm{\\theta}}(\\mathbf{X}_{b}))\\big)]"
  },
  {
    "tag": "div",
    "id": "alg3.l9",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "Perform a gradient step with respect to [MATH \\lambda] to maximize mini-batch validation log-likelihood: [MATH \\lambda\\leftarrow\\lambda+\\eta\\nabla_{\\lambda}\\log\\operatorname{P}\\left(\\mathbf{y}_{b}\\middle|\\mathbf{X}_{b},{\\bm{\\theta}}\\right)]"
  },
  {
    "tag": "div",
    "id": "alg3.l10",
    "ancestors": [
      "alg3.4",
      "alg3",
      "A6"
    ],
    "class_names": [
      "ltx_listingline"
    ],
    "text": "end for"
  }
]
