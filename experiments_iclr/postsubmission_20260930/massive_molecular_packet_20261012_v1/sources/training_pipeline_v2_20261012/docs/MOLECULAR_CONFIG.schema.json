{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gnnm-molecular-packet-config-v1",
  "title": "GINE/internal-BE molecular fit config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "molecular_inputs",
    "molecular_source",
    "model",
    "optimizer",
    "training",
    "arm",
    "fusion",
    "initialization_seed",
    "dropout_seed",
    "shuffle_seed",
    "head_policy",
    "target_policy",
    "contrastive"
  ],
  "properties": {
    "molecular_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "select"
      ],
      "properties": {
        "train": {
          "$ref": "#/$defs/receipt"
        },
        "select": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "molecular_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "factors",
        "objectives"
      ],
      "properties": {
        "models": {
          "$ref": "#/$defs/receipt"
        },
        "factors": {
          "$ref": "#/$defs/receipt"
        },
        "objectives": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "layers",
        "dropout",
        "outputs"
      ],
      "properties": {
        "hidden": {
          "type": "integer",
          "minimum": 1
        },
        "layers": {
          "type": "integer",
          "minimum": 1
        },
        "dropout": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "outputs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "learning_rate",
        "weight_decay",
        "eps",
        "betas"
      ],
      "properties": {
        "name": {
          "const": "Adam"
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0
        },
        "eps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "betas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
          }
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_size",
        "eval_batch_size",
        "views_per_update"
      ],
      "properties": {
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "eval_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "views_per_update": {
          "const": 2
        }
      }
    },
    "arm": {
      "enum": [
        "single",
        "single_contrastive",
        "factorized_single",
        "be_unit",
        "be_init",
        "be_unit_contrastive",
        "be_init_contrastive",
        "independent4_body",
        "independent4_body_contrastive",
        "factorized_independent4_body",
        "factorized_independent4_body_contrastive",
        "factorized_single_contrastive"
      ]
    },
    "fusion": {
      "const": "mean_logits"
    },
    "initialization_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "dropout_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "shuffle_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "head_policy": {
      "enum": [
        "archived_scalar",
        "declared_multitask_linear"
      ]
    },
    "target_policy": {
      "enum": [
        "complete_binary",
        "observed_binary_mask"
      ]
    },
    "contrastive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_objects",
        "alignment_weight",
        "residual_weight",
        "temperature"
      ],
      "properties": {
        "max_objects": {
          "type": "integer",
          "minimum": 1
        },
        "alignment_weight": {
          "type": "number",
          "minimum": 0
        },
        "residual_weight": {
          "type": "number",
          "minimum": 0
        },
        "temperature": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "maximum_cuda_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "independence_group": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "search",
        "comparative",
        "confirmation",
        "author_replication"
      ]
    },
    "reservation_mib": {
      "type": "integer",
      "minimum": 1
    },
    "estimated_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "selected_config_from": {
      "type": "string",
      "minLength": 1
    },
    "resolved_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_run_id",
        "config_id",
        "ranking_source",
        "choice_hash"
      ],
      "properties": {
        "selection_run_id": {
          "type": "string",
          "minLength": 1
        },
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "ranking_source": {
          "type": "string",
          "minLength": 1
        },
        "choice_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "head_policy": {
            "const": "archived_scalar"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "outputs": {
                "const": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "model": {
            "properties": {
              "outputs": {
                "minimum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "pattern": "_contrastive$"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "outputs": {
                "const": 1
              }
            }
          },
          "target_policy": {
            "const": "complete_binary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "pattern": "independent4_body"
          }
        }
      },
      "then": {
        "required": [
          "independence_group"
        ]
      },
      "else": {
        "not": {
          "required": [
            "independence_group"
          ]
        }
      }
    }
  ]
}
