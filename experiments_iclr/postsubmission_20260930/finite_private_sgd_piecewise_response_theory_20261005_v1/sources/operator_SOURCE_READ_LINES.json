  {
    "line": 209,
    "text": "def _query_objective(theta, adapted, forward, query_indices, query_labels, cfg):"
  },
  {
    "line": 210,
    "text": "    torch, functional = _backend()"
  },
  {
    "line": 211,
    "text": "    log_probs = torch.stack(["
  },
  {
    "line": 212,
    "text": "        functional.log_softmax(forward(theta, phi)[query_indices], dim=-1)"
  },
  {
    "line": 213,
    "text": "        for phi in adapted])"
  },
  {
    "line": 214,
    "text": "    targets = query_labels[None, :, None].expand(len(adapted), -1, 1)"
  },
  {
    "line": 215,
    "text": "    own = -log_probs.gather(2, targets).mean()"
  },
  {
    "line": 216,
    "text": "    pooled_log_probs = torch.logsumexp(log_probs, dim=0) - log(len(adapted))"
  },
  {
    "line": 225,
    "text": "        raise ValueError(\"Need members, >=2 classes and a declared control\")"
  },
  {
    "line": 226,
    "text": "    if cfg.assignment_steps != 8:"
  },
  {
    "line": 227,
    "text": "        raise ValueError(\"This source binds exactly eight assignment steps\")"
  },
  {
    "line": 228,
    "text": "    positive = (cfg.eta_probe, cfg.eta_private, cfg.eta_core, cfg.response_epsilon,"
  },
  {
    "line": 229,
    "text": "                cfg.entropy, cfg.assignment_rate, cfg.ratio_smoothing,"
  },
  {
    "line": 230,
    "text": "                cfg.reciprocal_smoothing)"
  },
  {
    "line": 231,
    "text": "    if not all(isfinite(value) and value > 0.0 for value in positive):"
  },
  {
    "line": 232,
    "text": "        raise ValueError(\"Strictly positive step/entropy/smoothing constants required\")"
  },
  {
    "line": 276,
    "text": "    pairs = _pair_blocks(inner_labels, public_affinity, num_classes)"
  },
  {
    "line": 277,
    "text": ""
  },
  {
    "line": 278,
    "text": "    def outer(core):"
  },
  {
    "line": 279,
    "text": "        adapted, _ = _private_response(core, private_start, forward,"
  },
  {
    "line": 280,
    "text": "                                       inner_indices, inner_labels, pairs,"
  },
  {
    "line": 281,
    "text": "                                       num_classes, cfg, control)"
  },
  {
    "line": 282,
    "text": "        return _query_objective(core, adapted, forward,"
  },
  {
    "line": 283,
    "text": "                                query_indices, query_labels, cfg)"
  },
  {
    "line": 285,
    "text": "    core_gradient, virtual_query_loss = torch.func.grad_and_value(outer)(theta_start)"
  },
  {
    "line": 286,
    "text": "    theta_next = _detach(_sgd(theta_start, core_gradient, cfg.eta_core))"
  },
  {
    "line": 287,
    "text": "    # Recompute EVERYTHING at theta+, starting from original private phi."
  },
  {
    "line": 288,
    "text": "    # The preliminary probe and theta-time virtual main response are discarded."
  },
  {
    "line": 289,
    "text": "    recomputed, diagnostics = _private_response("
  },
  {
    "line": 290,
    "text": "        theta_next, private_start, forward, inner_indices, inner_labels, pairs,"
  },
  {
    "line": 291,
    "text": "        num_classes, cfg, control, collect_diagnostics=True)"
  },
  {
    "line": 292,
    "text": "    private_next = tuple(_detach(phi) for phi in recomputed)"
  },
  {
    "line": 293,
    "text": "    diagnostics[\"virtual_query_loss\"] = virtual_query_loss.detach()"
  }
