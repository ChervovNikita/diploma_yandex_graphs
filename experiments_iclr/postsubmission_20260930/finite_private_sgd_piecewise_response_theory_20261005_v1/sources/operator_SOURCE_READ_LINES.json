  {
    "line": 65,
    "text": "def _own_ce(theta, phi, forward, indices, labels):"
  },
  {
    "line": 66,
    "text": "    _, functional = _backend()"
  },
  {
    "line": 67,
    "text": "    return functional.cross_entropy(forward(theta, phi)[indices], labels)"
  },
  {
    "line": 68,
    "text": ""
  },
  {
    "line": 69,
    "text": ""
  },
  {
    "line": 72,
    "text": "    _, functional = _backend()"
  },
  {
    "line": 73,
    "text": "    gap = (logits[:, pair.nodes, pair.competitors]"
  },
  {
    "line": 74,
    "text": "           - logits[:, pair.nodes, pair.targets])"
  },
  {
    "line": 75,
    "text": "    return functional.softplus(gap).transpose(0, 1)"
  },
