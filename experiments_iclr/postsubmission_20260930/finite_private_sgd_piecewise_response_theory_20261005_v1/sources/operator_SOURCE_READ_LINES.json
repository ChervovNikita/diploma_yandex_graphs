    "text": ""
  },
  {
    "line": 78,
    "text": "def _pair_blocks(labels, public_affinity, num_classes):"
  },
  {
    "line": 79,
    "text": "    \"\"\"All unordered pairs; no same-label/homophily edge filter.\"\"\""
  },
  {
    "line": 139,
    "text": "    return own + cfg.extra_margin * (members / count) * allocated"
  },
  {
    "line": 140,
    "text": ""
  },
  {
    "line": 141,
    "text": ""
  },
  {
    "line": 142,
    "text": "def _private_response(theta, phis, forward, inner_indices, inner_labels,"
  },
  {
    "line": 143,
    "text": "                      pairs, num_classes, cfg: Config, control=\"live\","
  },
  {
    "line": 144,
    "text": "                      collect_diagnostics=False):"
  },
  {
    "line": 145,
    "text": "    \"\"\"Probe is discarded; only the independent-Q main response is returned.\"\"\""
  },
  {
    "line": 146,
    "text": "    torch, functional = _backend()"
  },
  {
    "line": 147,
    "text": "    before = torch.stack([forward(theta, phi)[inner_indices] for phi in phis])"
  },
  {
    "line": 148,
    "text": "    own_partial = torch.func.grad(_own_ce, argnums=1)"
  },
  {
    "line": 149,
    "text": "    probes = tuple(_sgd(phi, own_partial(theta, phi, forward,"
  },
  {
    "line": 150,
    "text": "                                        inner_indices, inner_labels), cfg.eta_probe)"
  },
  {
    "line": 151,
    "text": "                   for phi in phis)"
  },
  {
    "line": 152,
    "text": "    after = torch.stack([forward(theta, phi)[inner_indices] for phi in probes])"
  },
  {
    "line": 153,
    "text": "    q_blocks, diagnostics = [], []"
  },
  {
    "line": 154,
    "text": "    gamma = 0.0 if control == \"graph_free\" else cfg.graph"
  },
  {
    "line": 155,
    "text": "    for pair in pairs:"
  },
  {
    "line": 156,
    "text": "        before_margin, after_margin = _margin(before, pair), _margin(after, pair)"
  },
  {
    "line": 157,
    "text": "        response = after_margin - before_margin"
  },
  {
    "line": 158,
    "text": "        raw = before_margin if control == \"margins\" else response"
  },
  {
    "line": 159,
    "text": "        cost, centered, scale = _normalized_cost(raw, cfg.response_epsilon)"
  },
  {
    "line": 160,
    "text": "        q = _assignment_map(cost, pair.laplacian, cfg, gamma)"
  },
  {
    "line": 161,
    "text": "        if control == \"uniform\":"
  },
  {
    "line": 162,
    "text": "            q = torch.full_like(q, 1.0 / len(phis))"
  },
  {
    "line": 163,
    "text": "        if control == \"stop_q\":"
  },
  {
    "line": 164,
    "text": "            q = q.detach()       # ONLY this control stops the outer Q chain."
  },
  {
    "line": 165,
    "text": "        q_blocks.append(q)"
  },
  {
    "line": 166,
    "text": "        if collect_diagnostics:"
  },
  {
    "line": 167,
    "text": "            qd, cd, sd = q.detach(), centered.detach(), scale.detach()"
  },
  {
    "line": 168,
    "text": "            response_centered = (response - response.mean(dim=1, keepdim=True)).detach()"
  },
  {
    "line": 169,
    "text": "            delta = qd - 1.0 / len(phis)"
  },
  {
    "line": 170,
    "text": "            diagnostics.append({"
  },
  {
    "line": 171,
    "text": "                \"classes\": pair.classes,"
  },
  {
    "line": 172,
    "text": "                \"item_count\": pair.nodes.shape[0],"
  },
  {
    "line": 173,
    "text": "                \"left_count\": (pair.targets == pair.classes[0]).sum(),"
  },
  {
    "line": 174,
    "text": "                \"right_count\": (pair.targets == pair.classes[1]).sum(),"
  },
  {
    "line": 175,
    "text": "                \"cost_kind\": \"current_margins\" if control == \"margins\" else \"response\","
  },
  {
    "line": 176,
    "text": "                \"centered_response_rms\": response_centered.square().mean().sqrt(),"
  },
  {
    "line": 177,
    "text": "                \"centered_cost_rms\": cd.square().mean().sqrt(),"
  },
  {
    "line": 178,
    "text": "                \"smooth_cost_scale\": sd,"
  },
  {
    "line": 179,
    "text": "                \"epsilon_over_scale\": cfg.response_epsilon / sd,"
  },
  {
    "line": 180,
    "text": "                \"normalized_cost_rms\": (cd / sd).square().mean().sqrt(),"
  },
  {
    "line": 181,
    "text": "                \"assignment_relative_rms\": len(phis) * delta.square().mean().sqrt(),"
  },
  {
    "line": 182,
    "text": "                \"assignment_max_deviation\": delta.abs().max(),"
  },
  {
    "line": 183,
    "text": "                \"mean_entropy\": -(qd * qd.log()).sum(dim=1).mean(),"
  },
  {
    "line": 184,
    "text": "                \"min_assignment\": qd.min(),"
  },
  {
    "line": 185,
    "text": "                \"row_residual\": (qd.sum(dim=1) - 1.0).abs().max(),"
  },
  {
    "line": 186,
    "text": "                \"column_residual\": (qd.sum(dim=0) - qd.shape[0] / len(phis)).abs().max(),"
  },
  {
    "line": 187,
    "text": "            })"
  },
  {
    "line": 188,
    "text": "    q_blocks = tuple(q_blocks)"
  },
  {
    "line": 189,
    "text": "    # torch.func.grad differentiates the private ARGUMENT, not a prebuilt graph."
  },
  {
    "line": 190,
    "text": "    # It treats Q as independent here, then preserves the returned gradient's"
  },
  {
    "line": 191,
    "text": "    # dependence on the supplied Q(theta, ALL phi) for the outer core derivative."
  },
  {
    "line": 192,
    "text": "    main_partial = torch.func.grad(_main_loss, argnums=1)"
  },
  {
    "line": 193,
    "text": "    adapted = tuple(_sgd(phi, main_partial(theta, phi, q_blocks, member, forward,"
  },
  {
    "line": 194,
    "text": "                                           inner_indices, inner_labels, pairs,"
  },
  {
    "line": 195,
    "text": "                                           num_classes, cfg), cfg.eta_private)"
  },
  {
    "line": 196,
    "text": "                    for member, phi in enumerate(phis))"
  },
  {
    "line": 197,
    "text": "    if collect_diagnostics:"
  },
  {
    "line": 198,
    "text": "        probe_ce_change = torch.stack(["
  },
  {
    "line": 199,
    "text": "            functional.cross_entropy(after[m], inner_labels)"
  },
  {
    "line": 200,
    "text": "            - functional.cross_entropy(before[m], inner_labels)"
  },
  {
    "line": 201,
    "text": "            for m in range(len(phis))]).detach()"
  },
  {
    "line": 202,
    "text": "        info = {\"pairs\": tuple(diagnostics), \"probe_own_ce_change\": probe_ce_change,"
  },
  {
    "line": 203,
    "text": "                \"assignments\": tuple(q.detach() for q in q_blocks)}"
  },
  {
    "line": 204,
    "text": "    else:"
  },
  {
    "line": 205,
    "text": "        info = None"
  },
  {
    "line": 206,
    "text": "    return adapted, info"
  },
